												init="[this,spectral] call BIS_fnc_attachToRelative;" \n "this setObjectScale 0.4;" \n "" \n "this setVariable [""bis_disabled_Door_1"", 1];" \n "" \n "this addAction [" \n "  ""<t color='#99ff0000'>Hangar door cannot be opened while ship is not anchored</t>""," \n "  {}," \n "  []," \n "  1," \n "  true," \n "  true," \n "  """"," \n "  ""!ShipAnchored""," \n "  7  " \n "];" \n "" \n "this addAction [" \n "  ""Enter vehicle hangar""," \n "  {" \n "    if (vehicle player != player) then {" \n "      vehicle player setPosASL (getPosASL spectral_rearPadIntDoorCube);" \n "      vehicle player setDir (getDir spectral_rearPadIntDoorCube);" \n "      [vehicle player, false] remoteExec [""allowDamage"", 0];" \n "    } else {" \n "      player setPosASL (getPosASL spectral_rearPadIntDoorCube);" \n "      player setDir (getDir spectral_rearPadIntDoorCube);" \n "    };" \n "  }," \n "  []," \n "  1," \n "  true," \n "  true," \n "  """"," \n "  ""ShipAnchored""," \n "  7" \n "];";
