													side="Empty";
													flags=1;
													class Attributes
													{
														init="""// disable the default door actions by marking it destroyed," \n " // then replace it with our own open/close actions so that we" \n " // can lock those out when the door is locked via tablet"";" \n "" \n "this setDamage [1, false];" \n "this setVariable [""WS_armory_locked"", true, true];" \n "" \n "this addAction [" \n "  ""Open Door""," \n "  {" \n "    params ["""","""","""", ""_args""];" \n "    _args#0 animate [""Door_1_a_rot"", 1];" \n "  }," \n "  [this]," \n "  2," \n "  true," \n "  true," \n "  """"," \n "  ""!(_target getVariable [""""WS_armory_locked"""", false])" \n "   && (_target animationPhase """"Door_1_a_rot"""" < 0.5)""," \n "  3" \n "];" \n "" \n "this addAction [" \n "  ""Close Door""," \n "  {" \n "    params ["""","""","""", ""_args""];" \n "    _args#0 animate [""Door_1_a_rot"", 0];" \n "  }," \n "  [this]," \n "  2," \n "  true," \n "  true," \n "  """"," \n "  ""!(_target getVariable [""""WS_armory_locked"""", false])" \n "   && (_target animationPhase """"Door_1_a_rot"""" > 0.5)" \n "  ""," \n "  3" \n "];" \n "" \n "[" \n "  this," \n "  ""engineering""," \n "  ""Disable door locking mechanism""," \n "  ""_target getVariable [""""WS_armory_locked"""", false]""," \n "  {" \n "    params [""_target""];" \n "    _target setVariable [""WS_armory_locked"", false, true];" \n "  }," \n "  15," \n "  false" \n "] call WS_fnc_HoldAction;";
														name="armory_wall";
														dynamicSimulation=1;
													};
