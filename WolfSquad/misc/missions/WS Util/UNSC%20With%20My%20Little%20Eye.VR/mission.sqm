													};
													side="Empty";
													flags=1;
													class Attributes
													{
														init="[this] spawn {" \n "  waitUntil { !isNil ""WS_RC_Ready"" };" \n "" \n "  params [""_this""];" \n "  [""armory"", ""controllers"", [_this]] call WS_fnc_RC_RegisterElem;" \n "};" \n "" \n "this addAction [" \n "  ""Lock armory door""," \n "  {" \n "    armory_wall setVariable [""WS_armory_locked"", true, true];" \n "  }," \n "  []," \n "  4," \n "  true," \n "  true," \n "  """"," \n "  ""!(armory_wall getVariable [""""WS_armory_locked"""", false])""," \n "  3" \n "];" \n "" \n "this addAction [" \n "  ""Unlock armory door""," \n "  {" \n "    armory_wall setVariable [""WS_armory_locked"", false, true];" \n "  }," \n "  []," \n "  4," \n "  true," \n "  true," \n "  """"," \n "  ""armory_wall getVariable [""""WS_armory_locked"""", false]""," \n "  3" \n "];";
														name="armory_controller";
														disableSimulation=1;
													};
													id=8678;
													type="Land_Tablet_02_black_F";
													atlOffset=0.86222839;
													class CustomAttributes
													{
														class Attribute0
														{
