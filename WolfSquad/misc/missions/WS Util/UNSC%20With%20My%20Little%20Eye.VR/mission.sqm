												text="2. DoorHandler";
												condition="mainSetupDone";
												onActivation="if (!isServer) exitWith { };" \n "" \n "WS_fnc_RC_RegisterDoor = {" \n "  params [" \n "    [""_roomName"", """", [""""]]," \n "    [""_door"", objNull, [objNull]]," \n "    [""_lockFnc"", { }, [{ }]]," \n "    [""_unlockFnc"", { }, [{ }]]," \n "    [""_doorbell"", objNull, [objNull]]," \n "    [""_locked"", false, [false]]    " \n "  ];" \n "" \n "  _door setVariable [""WS_Door_Lock"", _lockFnc, true];" \n "  _door setVariable [""WS_Door_Unlock"", _unlockFnc, true];" \n "  _door setVariable [""WS_Door_Bell"", _doorbell, true];" \n "  _door setVariable [""WS_Door_Locked"", _locked, true];" \n "" \n "  ""// action for when locked"";" \n "  _door addAction [" \n "    ""<t color='#ff2222'>LOCKED</t>""," \n "    { }," \n "    []," \n "    2," \n "    true," \n "    false," \n "    """"," \n "    ""_target getVariable [""""WS_Door_Locked"""", false]""," \n "    3" \n "  ];" \n "" \n "  ""// holdaction to door to override mechanism"";" \n "  [" \n "    _door," \n "    ""engineering""," \n "    ""Disengage door lock hydraulics""," \n "    ""_target getVariable [""""WS_Door_Locked"""", false]""," \n "    {" \n "      params [""_target""];" \n "      _unlockFnc = _target getVariable [""WS_Door_Unlock"", { }];" \n "      _target call _unlockFnc;" \n "      _target setVariable [""WS_Door_Locked"", false, true];" \n "      ""Hydraulics disengaged!"" call WS_fnc_EnvMsg;" \n "    }," \n "    15," \n "    false" \n "  ] call WS_fnc_HoldAction;" \n "" \n "" \n "  if (_doorbell != objNull) then {" \n "    _doorbell setVariable [""WS_Door"", _door, true];" \n "" \n "    ""// add ring action to doorbell"";" \n "    _doorbell addAction [" \n "      ""Ring""," \n "      {" \n "        params ["""", """", """", ""_args""];" \n "        _room = _args#0;" \n "" \n "        _controllers = [_room, ""controllers""] call WS_fnc_RC_GetElems;" \n "        {" \n "          playSound3D [" \n "            ""\z\phen\addons\common\sounds\failure.ogg""," \n "            _x," \n "            true" \n "          ];" \n "        } forEach _controllers;" \n "      }," \n "      [_roomName]," \n "      2," \n "      true," \n "      true," \n "      """"," \n "      ""true""," \n "      3" \n "    ];" \n "" \n "    ""// holdaction to doorbell to hack lock"";" \n "    [" \n "      _doorbell," \n "      ""hacking""," \n "      ""Override door lock command""," \n "      ""(_target getVariable """"WS_Door"""")" \n "        getVariable [""""WS_Door_Locked"""", false]""," \n "      {" \n "        params [""_target""];" \n "        _door = _target getVariable ""WS_Door"";" \n "        _unlockFnc = _door getVariable [""WS_Door_Unlock"", { }];" \n "        _door call _unlockFnc;" \n "        _door setVariable [""WS_Door_Locked"", false, true];" \n "        ""Lock command overridden!"" call WS_fnc_EnvMsg;" \n "      }," \n "      10," \n "      false" \n "    ] call WS_fnc_HoldAction;" \n "  };  " \n "" \n "  if (_locked) then {" \n "    _door call _lockFnc;" \n "  };" \n "" \n "  [_roomName, ""doors"", _door] call WS_fnc_RC_InsertElem;" \n "};" \n "publicVariable ""WS_fnc_RC_RegisterDoor"";" \n "" \n "" \n "" \n "WS_fnc_RC_UpdateDoors = {" \n "  params [" \n "    [""_roomName"", """", [""""]]," \n "    [""_lock"", false, [true]]" \n "  ];" \n "" \n "  _doors = [_roomName, ""doors""] call WS_fnc_RC_GetElems;" \n "  {" \n "    _fnc = { };" \n "    if (_lock) then {" \n "      _fnc = _x getVariable ""WS_Door_Lock"";" \n "    } else {" \n "      _fnc = _x getVariable ""WS_Door_Unlock"";" \n "    };" \n "" \n "    _x call _fnc;" \n "    _x setVariable [""WS_Door_Locked"", _lock, true];" \n "  } forEach _doors;" \n "};" \n "publicVariable ""WS_fnc_RC_UpdateDoors"";" \n "" \n "" \n "[""INFO"", ""RC DoorHandler initialized""] call WS_fnc_LogMsg;" \n "missionNamespace setVariable [""WS_RC_DoorHandler_Ready"", true];";
												sizeA=0;
												sizeB=0;
											};
