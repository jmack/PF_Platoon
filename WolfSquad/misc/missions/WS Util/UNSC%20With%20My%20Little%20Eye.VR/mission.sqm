										onActivation="if (!server) exitWith { };" \n "[""DEBUG"", ""AnchorWatcher starting""] call WS_fnc_LogMsg;" \n "" \n "ShipAnchored = false;" \n "publicVariable ""ShipAnchored"";" \n "" \n "ItemsAttachedToShip = [" \n "  rear_pad_floor_1," \n "  rear_pad_floor_2," \n "  rear_pad_floor_3," \n "  rear_pad_floor_4," \n "  rear_pad_floor_5," \n "  rear_pad_floor_6," \n "  rear_pad_floor_7," \n "  rear_pad_floor_8," \n "  rear_pad_floor_9," \n "  rear_pad_floor_10," \n "  rear_pad_floor_11," \n "  rear_pad_floor_12," \n "  rear_pad_floor_13," \n "  rear_pad_floor_14," \n "  rear_pad_floor_15," \n "  rear_pad_floor_16," \n "  rear_pad_floor_17," \n "  rear_pad_fence_1," \n "  rear_pad_fence_2," \n "  rear_pad_fence_3," \n "  rear_pad_fence_4," \n "  rear_pad_fence_5," \n "  rear_pad_fence_6," \n "  rear_pad_fence_7," \n "  rear_pad_fence_8," \n "  rear_pad_fence_9," \n "  rear_pad_fence_10," \n "  rear_pad_fence_11," \n "  rear_pad_fence_12," \n "  rear_pad_fence_13," \n "  rear_pad_fence_14," \n "  rear_pad_fence_15," \n "  rear_pad_fence_16," \n "  rear_pad_fence_17," \n "  rear_pad_fence_18," \n "  rear_pad_fence_19," \n "  rear_pad_fence_20," \n "  rear_pad_fence_21," \n "  rear_pad_fence_22," \n "  rear_pad_fence_23," \n "  rear_pad_fence_24," \n "  rear_pad_fence_25," \n "  rear_pad_fence_26," \n "  rear_pad_fence_27," \n "  rear_pad_fence_28," \n "  rearPadExtDoor" \n "];" \n "publicVariable ""ItemsAttachedToShip"";" \n "" \n "fnc_anchorToggleAttached = {" \n "  params [""_anchorOn""];" \n "" \n "  if (_anchorOn) then {" \n "    {" \n "      detach _x;" \n "    } forEach ItemsAttachedToShip;" \n "  } else {" \n "    {" \n "      [_x,spectral] call BIS_fnc_attachToRelative;" \n "    } forEach ItemsAttachedToShip;" \n "  };" \n "" \n "  ShipAnchored = _anchorOn;" \n "  publicVariable ""ShipAnchored"";" \n "  [""INFO"", format [""Anchor state changed to %1"", _anchorOn]]" \n "    call WS_fnc_LogMsg;" \n "};" \n "publicVariable ""fnc_anchorToggleAttached"";" \n "" \n "" \n "" \n "[] spawn {" \n "  waitUntil { !isNil ""spectralWhisper"" };" \n "" \n "  _ship = missionNamespace getVariable ""spectralWhisper"";  " \n "  [""DEBUG"", ""Ship grabbed!""] call WS_fnc_LogMsg;" \n "  " \n "  _anchorPrevState = _ship getVariable [""SB_active"", false];" \n "" \n "  while { true } do {" \n "    _anchorState = _ship getVariable [""SB_active"", false];" \n "    if (_anchorPrevState != _anchorState) then {" \n "      _anchorPrevState = _anchorState;      " \n "      !_anchorState call fnc_anchorToggleAttached;" \n "    };" \n "    sleep 0.5;" \n "  };" \n "};" \n "" \n "[""INFO"", ""AnchorWatcher initialized""] call WS_fnc_LogMsg;";
