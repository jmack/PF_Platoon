											class Attributes
											{
												text="2. ControllerHandler";
												condition="mainSetupDone";
												onActivation="if (!isServer) exitWith { };" \n "" \n "WS_fnc_RC_RegisterController = {" \n "  params [" \n "    [""_roomName"", """", [""""]]," \n "    [""_controller"", objNull, [objNull]]" \n "  ];" \n "" \n "  if (_roomName == ""MASTER"") then {" \n "    ""// if room = reserved keyword master, it gets different options"";" \n "" \n "    ""XXXX External Lights"";" \n "" \n "    ""XXXX Set Combat Mode (hide lights, show alert, sets light lock)"";" \n "    _controller addAction [" \n "      ""Shipwide Combat Mode""," \n "      {" \n "        {" \n "          ""// hide normal lights"";" \n "          [_x, ""lights"", [true]] call WS_fnc_RC_UpdateElem;" \n "" \n "          ""// show alert lights"";" \n "          [_x, ""alert-lights"", [false]] call WS_fnc_RC_UpdateElem;" \n "        } forEach keys (localNamespace getVariable WS_RC_MapName);" \n "" \n "        ""// set light lock mode"";" \n "        sleep 0.5;" \n "        missionNamespace setVariable [""WS_RC_LightMode"", ""COMBAT"", true];" \n "      }," \n "      []," \n "      111," \n "      true," \n "      true," \n "      """"," \n "      ""missionNamespace getVariable" \n "        [""""WS_RC_LightMode"""", """"""""] != """"COMBAT""""""," \n "      3" \n "    ];" \n "" \n "    ""XXXX Set Normal Mode (releases light lock)"";" \n "    _controller addAction [" \n "      ""Shipwide: Standard Mode""," \n "      {" \n "        {" \n "          ""// set all lights to their last mode"";" \n "          _lights = [_x, ""lights""] call WS_fnc_RC_GetElems;" \n "          [" \n "            _x," \n "           ""lights""," \n "           [_lights#0 getVariable ""WS_Light_LastMode""]" \n "         ] call WS_fnc_RC_UpdateElem;" \n "" \n "" \n "          ""// hide alert lights"";" \n "          [_x, ""alert-lights"", [true]] call WS_fnc_RC_UpdateElem;" \n "        } forEach keys (localNamespace getVariable WS_RC_MapName);" \n "" \n "        ""// unset special light mode"";" \n "        sleep 0.5;" \n "        missionNamespace setVariable [""WS_RC_LightMode"", """", true];" \n "      }," \n "      []," \n "      109," \n "      true," \n "      true," \n "      """"," \n "      ""missionNamespace getVariable" \n "        [""""WS_RC_LightMode"""", """"""""] != """"""""""," \n "      3" \n "    ];" \n "" \n "" \n "  } else {" \n "    _controller setVariable [""room"", _roomName];" \n "" \n "" \n "    ""XXXX Lights"";" \n "    _controller addAction [" \n "      ""Lights on""," \n "      {" \n "        params ["""","""","""",""_args""];" \n "        [" \n "          _args#0," \n "          ""lights""," \n "          [false]" \n "        ] call WS_fnc_RC_UpdateElem;" \n "      }," \n "      [_roomName]," \n "      6," \n "      true," \n "      true," \n "      """"," \n "      format [""" \n "        (count ([""""%1"""", """"lights""""] call WS_fnc_RC_GetElems) > 0)" \n "        &&" \n "        isObjectHidden (" \n "          ([""""%1"""", """"lights""""] call WS_fnc_RC_GetElems)#0" \n "        )" \n "        &&" \n "        missionNamespace getVariable [""""WS_RC_LightMode"""", """"""""] == """"""""" \n "      "", _roomName]," \n "      3" \n "    ];" \n "" \n "    _controller addAction [" \n "      ""Lights off""," \n "      {" \n "        params ["""","""","""",""_args""];" \n "        [" \n "          _args#0," \n "          ""lights""," \n "          [true]" \n "        ] call WS_fnc_RC_UpdateElem;" \n "      }," \n "      [_roomName]," \n "      6," \n "      true," \n "      true," \n "      """"," \n "      format [""" \n "        (count ([""""%1"""", """"lights""""] call WS_fnc_RC_GetElems) > 0)" \n "        &&" \n "        !isObjectHidden (" \n "          ([""""%1"""", """"lights""""] call WS_fnc_RC_GetElems)#0" \n "        )" \n "        &&" \n "        missionNamespace getVariable [""""WS_RC_LightMode"""", """"""""] == """"""""" \n "      "", _roomName]," \n "      3" \n "    ];" \n "" \n "    _controller addAction [" \n "      ""<t color='#77ffffff'>Lights overridden from bridge</t>""," \n "      { }," \n "      []," \n "      6," \n "      true," \n "      true," \n "      """"," \n "      ""missionNamespace getVariable [""""WS_RC_LightMode"""", """"""""] != """"""""""," \n "      3" \n "    ];" \n "" \n "" \n "    ""XXXX Shutters"";" \n "    ""---- add shutters open action"";" \n "    _controller addAction [" \n "      ""Open shutters""," \n "      {" \n "        params ["""","""","""",""_args""];" \n "        [" \n "          _args#0," \n "          ""shutters""," \n "          [true]" \n "        ] call WS_fnc_RC_UpdateElem;" \n "      }," \n "      [_roomName]," \n "      5," \n "      true," \n "      true," \n "      """"," \n "      format [""" \n "        (count ([""""%1"""", """"shutters""""] call WS_fnc_RC_GetElems) > 0)" \n "        &&" \n "        !isObjectHidden (" \n "          ([""""%1"""", """"shutters""""] call WS_fnc_RC_GetElems)#0" \n "        )" \n "      "", _roomName]," \n "      3" \n "    ];" \n "" \n "    _controller addAction [" \n "      ""Close shutters""," \n "      {" \n "        params ["""","""","""",""_args""];" \n "        [" \n "          _args#0," \n "          ""shutters""," \n "          [false]" \n "        ] call WS_fnc_RC_UpdateElem;" \n "      }," \n "      [_roomName]," \n "      5," \n "      true," \n "      true," \n "      """"," \n "      format [""" \n "        (count ([""""%1"""", """"shutters""""] call WS_fnc_RC_GetElems) > 0)" \n "        &&" \n "        isObjectHidden (" \n "          ([""""%1"""", """"shutters""""] call WS_fnc_RC_GetElems)#0" \n "        )" \n "      "", _roomName]," \n "      3" \n "    ];" \n "" \n "" \n "    ""XXXX Doors"";" \n "    _controller addAction [" \n "      ""Lock doors""," \n "      {" \n "        params ["""","""","""",""_args""];" \n "        [" \n "          _args#0," \n "          ""doors""," \n "          [true]" \n "        ] call WS_fnc_RC_UpdateElem;" \n "      }," \n "      [_roomName]," \n "      4," \n "      true," \n "      true," \n "      """"," \n "      format [""" \n "        (count ([""""%1"""", """"doors""""] call WS_fnc_RC_GetElems) > 0)" \n "        &&" \n "        (" \n "          ([""""%1"""", """"doors""""] call WS_fnc_RC_GetElems)#0" \n "        ) getVariable [""""WS_Door_Locked"""", false] == false""," \n "        _roomName" \n "      ]," \n "      3" \n "    ];   " \n "" \n "    _controller addAction [" \n "      ""Unlock doors""," \n "      {" \n "        params ["""","""","""",""_args""];" \n "        [" \n "          _args#0," \n "          ""doors""," \n "          [false]" \n "        ] call WS_fnc_RC_UpdateElem;" \n "      }," \n "      [_roomName]," \n "      4," \n "      true," \n "      true," \n "      """"," \n "      format [""" \n "        (count ([""""%1"""", """"doors""""] call WS_fnc_RC_GetElems) > 0)" \n "        &&" \n "        (" \n "          ([""""%1"""", """"doors""""] call WS_fnc_RC_GetElems)#0" \n "        ) getVariable [""""WS_Door_Locked"""", false] == true""," \n "        _roomName" \n "      ]," \n "      3" \n "    ];" \n "" \n "" \n "    [_roomName, ""controllers"", _controller] call WS_fnc_RC_InsertElem;" \n "  };" \n "};" \n "publicVariable ""WS_fnc_RC_RegisterController"";" \n "" \n "missionNamespace setVariable [""WS_RC_ControllerHandler_Ready"", true];" \n "[""INFO"", ""RC Controller Handler initialized""] call WS_fnc_LogMsg;";
												sizeA=0;
												sizeB=0;
