										class Item0
										{
											dataType="Trigger";
											position[]={1650.1,115,5925};
											class Attributes
											{
												text="0. Room Coordinator (RC)";
												condition="mainSetupDone";
												onActivation="if (!isServer) exitWith { };" \n "missionNamespace setVariable [""WS_RC_MapName"", ""WS_RC_Map"", true];" \n "" \n "" \n "" \n "WS_fnc_RC_InsertElem = {" \n "  params [" \n "    [""_roomName"", """", [""""]]," \n "    [""_elemType"", """", [""""]]," \n "    [""_elem"", objNull, [objNull]]" \n "  ];" \n "" \n "  _map = localNamespace getVariable [WS_RC_MapName, createHashMap];" \n "" \n "  if (_roomName in _map) then {" \n "    _room = _map get _roomName;" \n "    if (_elemType in _room) then {" \n "      ""// room exists and type exists"";" \n "      _elems = _room get _elemType;" \n "      _elems pushBack _elem;" \n "      _room set [_elemType, _elems];" \n "    } else {" \n "      ""// room exists but type does not exist on room"";" \n "      _room set [_elemType, [_elem]];" \n "    };" \n "  } else {" \n "    ""// room does not exist, create it fresh"";" \n "    _map set [" \n "      _roomName," \n "      createHashMapFromArray [" \n "        [_elemType, [_elem]]        " \n "      ]" \n "    ];" \n "  };" \n "" \n "  localNamespace setVariable [WS_RC_MapName, _map];" \n "};" \n "publicVariable ""WS_fnc_RC_InsertElem"";" \n "" \n "" \n "" \n "WS_fnc_RC_GetElems = {" \n "  params [" \n "    [""_roomName"", """", [""""]]," \n "    [""_elemType"", """", [""""]]" \n "  ];" \n "" \n "  _map = localNamespace getVariable [WS_RC_MapName, createHashMap];" \n "  if (!(_roomName in _map)) exitWith { [] };" \n "  _room = _map get _roomName;" \n "  if (!(_elemType in _room)) exitWith { [] };" \n "  " \n "  _room get _elemType;" \n "};" \n "publicVariable ""WS_fnc_RC_GetElems"";" \n "" \n "" \n "" \n "WS_fnc_RC_RegisterElem = {" \n "  params [" \n "    [""_roomName"", """", [""""]]," \n "    [""_elemType"", """", [""""]]," \n "    [""_registerArgs"", [], [[]]]" \n "  ];" \n "" \n "  ""// RegisterElem should ONLY BE CALLED FROM INIT as it does not have       //  remoteExec set up."";" \n "" \n "  switch (_elemType) do" \n "  {" \n "    case ""lights"": {" \n "      [" \n "        _roomName," \n "        _registerArgs#0," \n "        _registerArgs param [1, false]" \n "      ] call WS_fnc_RC_RegisterLight;" \n "    };" \n "    case ""controllers"": {" \n "      [_roomName, _registerArgs#0] call WS_fnc_RC_RegisterController;" \n "    };" \n "    case ""shutters"": {" \n "      [_roomName, _registerArgs#0] call WS_fnc_RC_RegisterShutter;" \n "    };" \n "    case ""alert-lights"": {" \n "      [_roomName, _registerArgs#0] call WS_fnc_RC_RegisterAlertLight;" \n "    };" \n "    case ""doors"": {" \n "      [" \n "        _roomName," \n "        _registerArgs#0," \n "        _registerArgs#1," \n "        _registerArgs#2," \n "        _registerArgs#3," \n "        _registerArgs#4" \n "      ] call WS_fnc_RC_RegisterDoor;" \n "    };" \n "    default {" \n "      [" \n "        ""WARN""," \n "        format [" \n "          ""WS_fnc_RegisterElem was called with an unsupported elemType! [Room: %1, ElemType: %2, RegisterArgs: %3]""," \n "           _roomName," \n "           _elemType," \n "           _registerArgs" \n "        ]" \n "      ] call WS_fnc_LogMsg;" \n "    };" \n "  };" \n "};" \n "publicVariable ""WS_fnc_RC_RegisterElem"";" \n "" \n "" \n "" \n "WS_fnc_RC_UpdateElem = {" \n "  params [" \n "    [""_roomName"", """", [""""]]," \n "    [""_elemType"", """", [""""]]," \n "    [""_updateArgs"", [], [[]]]" \n "  ];" \n "" \n "  switch (_elemType) do" \n "  {" \n "    case ""lights"": {" \n "      [" \n "        _roomName," \n "        _updateArgs#0" \n "      ] remoteExec [""WS_fnc_RC_UpdateLights"", 0];" \n "    };" \n "    case ""shutters"": {" \n "      [" \n "        _roomName," \n "        _updateArgs#0" \n "      ] remoteExec [""WS_fnc_RC_UpdateShutters"", 0];" \n "    };" \n "    case ""alert-lights"": {" \n "      [_roomName, _updateArgs#0] call WS_fnc_RC_UpdateAlertLights;" \n "    };" \n "    case ""doors"": {" \n "      [_roomName, _updateArgs#0] remoteExec [""WS_fnc_RC_UpdateDoors"", 0];" \n "    };" \n "    ""// controllers do not support update"";" \n "    default {" \n "      [" \n "        ""WARN""," \n "        format [" \n "          ""WS_fnc_UpdateElem was called with an unsupported elemType! [Room: %1, ElemType: %2, UpdateArgs: %3]""," \n "           _roomName," \n "           _elemType," \n "           _updateArgs" \n "        ]" \n "      ] call WS_fnc_LogMsg;" \n "    };" \n "  };" \n "};" \n "publicVariable ""WS_fnc_RC_UpdateElem"";" \n "" \n "" \n "" \n "[] spawn {" \n "  waitUntil { !isNil ""WS_RC_LightHandler_Ready"" };" \n "  waitUntil { !isNil ""WS_RC_ControllerHandler_Ready"" };" \n "  waitUntil { !isNil ""WS_RC_ShutterHandler_Ready"" };" \n "  waitUntil { !isNil ""WS_RC_AlertLightHandler_Ready"" };" \n "  waitUntil { !isNil ""WS_RC_DoorHandler_Ready"" };" \n "" \n "" \n "  missionNamespace setVariable [""WS_RC_Ready"", true, true];" \n "  [""INFO"", ""Room Coordinator initialized""] call WS_fnc_LogMsg;" \n "};";
