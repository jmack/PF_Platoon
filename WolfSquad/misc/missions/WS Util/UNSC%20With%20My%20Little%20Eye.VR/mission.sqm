								class Item3
								{
									dataType="Trigger";
									position[]={1650,115,5925.3999};
									class Attributes
									{
										text="TurretHandler (New)";
										condition="mainSetupDone";
										onActivation="if (!isServer) exitWith { };" \n "[""DEBUG"", ""Running TurretHandler Setup""] call WS_fnc_LogMsg;" \n "" \n "" \n "" \n """// Func to control a turret"";" \n "WS_fnc_ControlTurret = {" \n "  params [" \n "    [""_turret"", objNull, [objNull]]," \n "    [""_user"", objNull, [objNull]]" \n "  ];" \n "" \n "  [""DEBUG"", format [""%1 to control %2"", _user, _turret]]" \n "    call WS_fnc_LogMsg;" \n "" \n "  _crew = (crew _turret)#0;" \n "  [""DEBUG"", format [""crew: %1"", _crew]] call WS_fnc_LogMsg;" \n "" \n "  if (isNull (remoteControlled _crew)) then {" \n "    _crew switchCamera ""Internal"";" \n "    _user remoteControl _crew;" \n "  };" \n "};" \n "publicVariable ""WS_fnc_ControlTurret"";" \n "" \n "" \n "" \n """// Func to disable a turret"";" \n "WS_fnc_DisableTurret = {" \n "  params [" \n "    [""_turret"", objNull, [objNull]]" \n "  ];" \n "};" \n "publicVariable ""WS_fnc_DisableTurret"";" \n "" \n "" \n "" \n """// Func to enable a turret"";" \n "WS_fnc_EnableTurret = {" \n "  params [" \n "    [""_turret"", objNull, [objNull]]" \n "  ];" \n "};" \n "publicVariable ""WS_fnc_EnableTurret"";" \n "" \n "" \n "" \n """// Func to register a turret and set up actions on controller"";" \n "WS_fnc_ConnectTurret = {" \n "  params [" \n "    [""_turretObj"", objNull, [objNull]]," \n "    [""_turretType"", 0, [0]]," \n "    [""_turretName"", """", [""""]]," \n "    [""_startEnabled"", true, [true]]," \n "    [""_controller"", objNull, [objNull]]" \n "  ];" \n "" \n "  _controller addAction [" \n "    _turretName," \n "    {" \n "      params ["""", ""_user"", """", ""_args""];" \n "" \n "      [_args#0, _user] call WS_fnc_ControlTurret;" \n "    }," \n "    [_turretObj]," \n "    3," \n "    true," \n "    true," \n "    """"," \n "    ""true""," \n "    2" \n "  ];" \n "};" \n "publicVariable ""WS_fnc_ConnectTurret"";" \n "" \n "" \n "" \n "[""DEBUG"", ""TurretHandler initialized""] call WS_fnc_LogMsg;";
										sizeA=0;
										sizeB=0;
									};
									id=9492;
									type="EmptyDetector";
									atlOffset=110;
								};
								class Item4
								{
									dataType="Trigger";
									position[]={1650,115,5925.2002};
									class Attributes
									{
										text="TurretHandler";
										condition="mainSetupDone";
										onActivation="if (!isServer) exitWith { };" \n "[""DEBUG"", ""Running TurretHandler Setup""] call WS_fnc_LogMsg;" \n "" \n "" \n "" \n "WS_fnc_TurretSetupLocal = {" \n "  params [""_controller"", ""_turret"", ""_actionPriority""];" \n "" \n "  [""DEBUG"", format [""Controller: %1, Turret: %2"", _controller, _turret]]" \n "    call WS_fnc_LogMsg;" \n "" \n "  _controller addAction [" \n "    format [" \n "      ""Get in %1""," \n "      _turret getVariable [""WS_Turret_Name"", ""turret""]" \n "    ]," \n "    {" \n "      params ["""", ""_caller"", """", ""_args""];" \n "      _turret = _args#0;" \n "" \n "      [_caller, _turret] call SB_fnc_turretGetIn;" \n "    }," \n "    [_turret]," \n "    _actionPriority," \n "    true," \n "    true," \n "    """"," \n "    ""true""," \n "    3" \n "  ];" \n "};" \n "publicVariable ""WS_fnc_TurretSetupLocal"";" \n "" \n "" \n "" \n "[this] spawn {" \n "  params [""_this""];" \n "" \n "  _controllers = [" \n "    bridge_tacticalOps" \n "  ];" \n "" \n "  ""_turrets = [" \n "    M910_Fore," \n "    M910_Starboard," \n "    M910_Port," \n "    M910_Top," \n "    M71_Port," \n "    M71_Starboard," \n "    Archer_PortFore," \n "    Archer_PortAft," \n "    Archer_StarboardFore," \n "    Archer_StarboardAft" \n "  ];"";" \n "  _turrets = [];" \n "" \n "  waitUntil { !isNil ""spectralWhisper"" };" \n "  _ship = missionNamespace getVariable ""spectralWhisper"";" \n "  _totalTurrets = count _turrets;" \n "" \n "  {" \n "    _controller = _x;" \n "    {" \n "      _x setVariable [""SB_turretAvailable"", true, true];" \n "      _x setVariable [""SB_ship"", _ship, true];" \n "      [_x, _ship] call BIS_fnc_attachToRelative;" \n "      _x enableSimulationGlobal true;" \n "" \n "      [_controller, _x, (_totalTurrets - _forEachIndex)]" \n "        remoteExecCall [""WS_fnc_TurretSetupLocal"", 0, true];" \n "    } forEach _turrets;" \n "  } forEach _controllers;" \n "};" \n "  " \n "" \n "" \n "[""DEBUG"", ""TurretHandler initialized""] call WS_fnc_LogMsg;";
										sizeA=0;
										sizeB=0;
									};
									id=11439;
									type="EmptyDetector";
									atlOffset=110;
								};
							};
