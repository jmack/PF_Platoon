											class Attributes
											{
												text="2. LightHandler";
												condition="mainSetupDone";
												onActivation="if (!isServer) exitWith { };" \n "" \n "WS_fnc_RC_RegisterLight = {" \n "  params [" \n "    [""_roomName"", """", [""""]]," \n "    [""_obj"", objNull, [objNull]]," \n "    [""_startsHidden"", false, [false]]" \n "  ];" \n "" \n "  [_roomName, ""lights"", _obj] call WS_fnc_RC_InsertElem;" \n "" \n "  ""// Duplicate the object and make it static so something still" \n "   // shows when the object is hidden"";" \n "  _clone = createSimpleObject [typeOf _obj, getPosASL _obj, true];" \n "  _clone attachTo [_obj, [0, 0, 0]];" \n "  _clone setDir 0;" \n "" \n "  ""// handle whether the light starts on or not"";" \n "  _obj setVariable [""WS_Light_LastMode"", _startsHidden];" \n "  _obj hideObjectGlobal _startsHidden;" \n "};" \n "publicVariable ""WS_fnc_RC_RegisterLight"";" \n "" \n "" \n "" \n "WS_fnc_RC_UpdateLights = {" \n "  params [" \n "    [""_roomName"", """", [""""]]," \n "    [""_hide"", false, [true]]" \n "  ];" \n "" \n "  _lights = [_roomName, ""lights""] call WS_fnc_RC_GetElems;" \n "  {" \n "    _x setVariable [""WS_Light_LastMode"", (isObjectHidden _x)];" \n "    _x hideObjectGlobal _hide;" \n "" \n "  } forEach _lights;" \n "};" \n "publicVariable ""WS_fnc_RC_UpdateLights"";" \n "" \n "" \n "[""INFO"", ""RC LightHandler initialized""] call WS_fnc_LogMsg;" \n "missionNamespace setVariable [""WS_RC_LightHandler_Ready"", true];";
