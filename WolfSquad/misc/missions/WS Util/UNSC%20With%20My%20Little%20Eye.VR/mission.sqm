										onActivation="if (!isServer) exitWith {};" \n "" \n "[] spawn {" \n "  waitUntil { !isNil ""WS_fnc_InitHEVs"" };" \n "  _bayA = createHashMapFromArray [" \n "    [""owner"", heva_hevPanel]," \n "    [""rcname"", ""hev-a""]," \n "    [""panels"", [" \n "      heva_hevPanel," \n "      bridge_side_hevPanel," \n "      bridge_command_hevPanel" \n "    ]]," \n "    [""lights"", [" \n "      heva_dropLight_1," \n "      heva_dropLight_2," \n "      heva_dropLight_3" \n "    ]]," \n "    [""hevs"", [" \n "      hev_a_1," \n "      hev_a_2," \n "      hev_a_3," \n "      hev_a_4," \n "      hev_a_5," \n "      hev_a_6" \n "    ]]" \n "  ];" \n "  _bayB = createHashMapFromArray [" \n "    [""owner"", hevb_hevPanel]," \n "    [""rcname"", ""hev-b""]," \n "    [""panels"", [" \n "      hevb_hevPanel," \n "      bridge_side_hevPanel," \n "      bridge_command_hevPanel" \n "    ]]," \n "    [""lights"", [" \n "      hevb_dropLight_1," \n "      hevb_dropLight_2," \n "      hevb_dropLight_3" \n "    ]]," \n "    [""hevs"", [" \n "      hev_b_1," \n "      hev_b_2," \n "      hev_b_3," \n "      hev_b_4," \n "      hev_b_5," \n "      hev_b_6" \n "    ]]" \n "  ];" \n "" \n "  ""-- for testing purposes --"";" \n "  _bay1 = createHashMapFromArray [" \n "    [""owner"", hev1_hevPanel]," \n "    [""rcname"", ""hev-1""]," \n "    [""panels"", [" \n "      hev1_hevPanel," \n "      testing_joint_hevPanel" \n "    ]]," \n "    [""lights"", [" \n "      hev1_dropLight" \n "    ]]," \n "    [""hevs"", [" \n "      hev_1" \n "    ]]" \n "  ];" \n "  _bay2 = createHashMapFromArray [" \n "    [""owner"", hev2_hevPanel]," \n "    [""rcname"", ""hev-2""]," \n "    [""panels"", [" \n "      hev2_hevPanel," \n "      testing_joint_hevPanel" \n "    ]]," \n "    [""lights"", [" \n "      hev2_dropLight" \n "    ]]," \n "    [""hevs"", [" \n "      hev_2" \n "    ]]" \n "  ];" \n " " \n "" \n "  _map = createHashMapFromArray [" \n "    [""A"", _bayA]," \n "    [""B"", _bayB]," \n "    [""1"", _bay1]," \n "    [""2"", _bay2]" \n "  ];" \n "  [_map] call WS_fnc_InitHEVs;" \n "};";
