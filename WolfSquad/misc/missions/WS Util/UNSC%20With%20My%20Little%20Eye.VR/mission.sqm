													class Attributes
													{
														init="this addAction" \n "[" \n "  ""Lock Door""," \n "  {" \n "    params [""_target""];" \n "" \n "    if (rank player == ""COLONEL""" \n "      || _target getVariable [""WS_Auth_Bypass"", false]) then {" \n "      selfdestruct_door setDamage [1, false];" \n "      ""Door locked"" call WS_fnc_EnvMsg;" \n "    } else {" \n "      ""User lacks authorization"" call WS_fnc_EnvMsg;" \n "    };" \n "  }," \n "  []," \n "  4," \n "  true," \n "  true," \n "  """"," \n "  ""alive selfdestruct_door""," \n "  3" \n "];" \n "" \n "this addAction" \n "[" \n "  ""Unlock Door""," \n "  {" \n "    params [""_target""];" \n "" \n "    if (rank player == ""COLONEL""" \n "      || _target getVariable [""WS_Auth_Bypass"", false]) then {" \n "      selfdestruct_door setDamage 0;" \n "      ""Door unlocked"" call WS_fnc_EnvMsg;" \n "    } else {" \n "      ""User lacks authorization"" call WS_fnc_EnvMsg;" \n "    };" \n "  }," \n "  []," \n "  4," \n "  true," \n "  true," \n "  """"," \n "  ""!alive selfdestruct_door""," \n "  3" \n "];" \n "" \n "[" \n "  this," \n "  ""hacking""," \n "  ""Bypass user authorization""," \n "  ""!(selfdestruct_tablet getVariable [""""WS_Auth_Bypass"""", false])""," \n "  {" \n "    selfdestruct_tablet setVariable [""WS_Auth_Bypass"", true, true];" \n "    ""\> User authorization requirement removed"" call WS_fnc_EnvMsg;" \n "  }," \n "  20," \n "  false" \n "] call WS_fnc_HoldAction;";
														name="selfdestruct_tablet";
														disableSimulation=1;
													};
