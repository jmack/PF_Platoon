															side="Empty";
															flags=1;
															class Attributes
															{
																init="if (!isServer) exitWith { };" \n "" \n """/** Possible States" \n "  *    pressurized    - has air" \n "  *    depressurized  - no air" \n "  *    cycling        - going from one to the other" \n "  */" \n """;" \n "this setVariable [""WS_Airlock_State"", ""pressurized""];" \n "this setVariable [""WS_Airlock_Interior_State"", ""pressurized""];" \n "this setVariable [""WS_Airlock_Exterior_State"", ""pressurized""];" \n "_mainPanelName = vehicleVarName this;" \n "" \n """/**" \n "  *  Build the airlock map" \n "  */" \n """;" \n """// Interior"";" \n "_interior_door_map = createHashMapFromArray [" \n "  [""object"", lowerAirlock_storage_door]," \n "  [""lock"", {" \n "    params [""_this""];" \n "    _this setDamage [1, false];" \n "  }]," \n "  [""open"", {" \n "    params [""_this""];" \n "    _this animate ['Door_A_move', 1];" \n "    _this animate ['Door_B_move', 1];" \n "    _this animate ['Door_C_move', 1];" \n "  }]," \n "  [""close"", {" \n "    params [""_this""];" \n "    _this animate ['Door_A_move', 0];" \n "    _this animate ['Door_B_move', 0];" \n "    _this animate ['Door_C_move', 0];" \n "  }]" \n "];" \n "_interior_exteriorlights_map = createHashMapFromArray [" \n "  [""green"", lowerAirlock_storage_light_exterior_green]," \n "  [""yellow"", lowerAirlock_storage_light_exterior_yellow]," \n "  [""blue"", lowerAirlock_storage_light_exterior_blue]," \n "  [""red"", lowerAirlock_storage_light_exterior_red]" \n "];" \n "_interior_interiorlights_map = createHashMapFromArray [" \n "  [""green"", lowerAirlock_storage_light_interior_green]," \n "  [""yellow"", lowerAirlock_storage_light_interior_yellow]," \n "  [""blue"", lowerAirlock_storage_light_interior_blue]," \n "  [""red"", lowerAirlock_storage_light_interior_red]" \n "];" \n "_interior_map = createHashMapFromArray [" \n "  [""panel"", lowerAirlock_storage_panel]," \n "  [""door"", _interior_door_map]," \n "  [""exterior"", _interior_exteriorlights_map]," \n "  [""interior"", _interior_interiorlights_map]" \n "];" \n """// Exterior"";" \n "_exterior_door_map = createHashMapFromArray [" \n "  [""object"", lowerAirlock_hangar_door]," \n "  [""lock"", {" \n "    params [""_this""];" \n "    _this setDamage [1, false];" \n "  }]," \n "  [""open"", {" \n "    params [""_this""];" \n "    _this animate ['Door_A_move', 1];" \n "    _this animate ['Door_B_move', 1];" \n "    _this animate ['Door_C_move', 1];" \n "  }]," \n "  [""close"", {" \n "    params [""_this""];" \n "    _this animate ['Door_A_move', 0];" \n "    _this animate ['Door_B_move', 0];" \n "    _this animate ['Door_C_move', 0];" \n "  }]" \n "];" \n "_exterior_exteriorlights_map = createHashMapFromArray [" \n "  [""green"", lowerAirlock_hangar_light_exterior_green]," \n "  [""yellow"", lowerAirlock_hangar_light_exterior_yellow]," \n "  [""blue"", lowerAirlock_hangar_light_exterior_blue]," \n "  [""red"", lowerAirlock_hangar_light_exterior_red]" \n "];" \n "_exterior_interiorlights_map = createHashMapFromArray [" \n "  [""green"", lowerAirlock_hangar_light_interior_green]," \n "  [""yellow"", lowerAirlock_hangar_light_interior_yellow]," \n "  [""blue"", lowerAirlock_hangar_light_interior_blue]," \n "  [""red"", lowerAirlock_hangar_light_interior_red]" \n "];" \n "_exterior_map = createHashMapFromArray [" \n "  [""panel"", lowerAirlock_hangar_panel]," \n "  [""door"", _exterior_door_map]," \n "  [""exterior"", _exterior_exteriorlights_map]," \n "  [""interior"", _exterior_interiorlights_map]" \n "];" \n """// Final Map"";" \n "_airlock_map = createHashMapFromArray [" \n "  [""interior"", _interior_map]," \n "  [""exterior"", _exterior_map]" \n "];" \n "" \n "this setVariable [""WS_Airlock_Map"", _airlock_map, true];" \n "" \n "" \n "" \n """/**" \n "  *  Start the setup" \n "  */"";" \n "{" \n "  ""// lock each door so we get total control"";" \n "  _door_map = _y get ""door"";" \n "  _door_obj = _door_map get ""object"";" \n "  _door_lock_fnc = _door_map get ""lock"";" \n "  _door_obj call _door_lock_fnc;" \n "" \n "  ""/**" \n "    * add the open door action. conditions:" \n "    *  - door is not already open" \n "    *  - pressure on door side and airlock are same" \n "    */"";" \n "  _door_open_action_id = _door_obj addAction [" \n "    ""Open Door""," \n "    {" \n "      params [""_door"", """", """", ""_args""];" \n "      _controller = _args#0;" \n "      _map = _args#1;" \n "      _interiorLights = _args#2;" \n "      _exteriorLights = _args#3;" \n "" \n "      _openFnc = _map get ""open"";" \n "      _closeFnc = _map get ""close"";" \n "" \n "      _door call _openFnc;" \n "      [_interiorLights, ""yellow""] call WS_Airlock_SetLightMode;" \n "      [_exteriorLights, ""yellow""] call WS_Airlock_SetLightMode;" \n "      sleep 12;" \n "      _door call _closeFnc;" \n "      sleep 2;" \n "      [_interiorLights, ""green""] call WS_Airlock_SetLightMode;" \n "      [_exteriorLights, ""green""] call WS_Airlock_SetLightMode;" \n "    }," \n "    [" \n "      this," \n "      _door_map," \n "      _y get ""interior""," \n "      _y get ""exterior""" \n "    ]," \n "    5," \n "    true," \n "    true," \n "    """"," \n "    ""true""," \n "    5," \n "    false" \n "  ];" \n "  _doorObj setUserActionText [" \n "    _door_open_action_id," \n "    ""Open Airlock Door""," \n "    ""<img size='2' image='a3\ui_f\data\igui\cfg\actions\open_door_ca'/>""" \n "  ];" \n "" \n "} forEach _airlock_map;" \n "" \n "" \n "" \n """/**" \n "  * Utilities" \n "  */"";" \n "missionNamespace setVariable [""WS_Airlock_SetLightMode"", {" \n "  params [""_lightMap"", ""_color""];" \n "" \n "[""DEBUG"", format [""_lightMap: %1"", _lightMap]] call WS_fnc_LogMsg;" \n "[""DEBUG"", format [""_color: %1"", _color]] call WS_fnc_LogMsg;" \n "  " \n "  {" \n "    if (_x == _color) then {" \n "      _y hideObjectGlobal false;" \n "    } else {" \n "      _y hideObjectGlobal true;" \n "    };" \n "  } forEach _lightMap;" \n "}, true];";
																name="lowerAirlock_controller";
																disableSimulation=1;
															};
