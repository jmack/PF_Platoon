                    if (_actName == 'UnloadAllVehicles') exitWith { { objNull setVehicleCargo _x; } forEach (getVehicleCargo _v); };

                    if (_actName == 'RNL_RAPPEL_TROOPS') exitWith {
                        
                        '1. Playback pausieren (Friert Heli in der Luft ein)';
                        _v setVariable ['RNL_PAUSE_RESUME', true, true];

                        '2. Thread abspalten, da EachFrame kein Sleep zulaesst';
                        [_v, _fnc_name, _oldGrps, _agentPilot, _coPilot, _gunnerPilot, _fnc_doRappel] spawn {
                            params ['_v', '_fnc_name', '_oldGrps', '_agentPilot', '_coPilot', '_gunnerPilot', '_fnc_doRappel'];

                            'Infanterie filtern und sortieren (Leader zuerst, keine Klon-Crew)';
                            private _leaders = [];
                            private _subordinates = [];

                            {
                                if (alive _x && {!(_x in [_agentPilot, _coPilot, _gunnerPilot])} && {group _x != _oldGrps}) then {
