                    if (_actName == 'SearchLightOn') exitWith { { private _unit = _v turretUnit _x; if (!isNull _unit) then { _unit actionNow ['SearchLightOn', _v]; }; } forEach (allTurrets [_v, true]); };

                    if (_actName == 'SearchLightOff') exitWith { { private _unit = _v turretUnit _x; if (!isNull _unit) then { _unit actionNow ['SearchLightOff', _v]; }; } forEach (allTurrets [_v, true]); };

