                    if ( _recScriptStrLower find 'ls_vehicles_fnc_vivload' != -1) exitWith { private _canLoad = [_v, '', 15] call ls_vehicles_fnc_vivCanLoad; if (_canLoad) then { _v call ls_vehicles_fnc_vivLoad; }; };

                    private _str = _recScriptStr;
                    private _return = '';
                    private _find = 'this'; 
                    private _replace = '_v';
                    private _len = count _find; 
                    private _pos = _str find _find;
