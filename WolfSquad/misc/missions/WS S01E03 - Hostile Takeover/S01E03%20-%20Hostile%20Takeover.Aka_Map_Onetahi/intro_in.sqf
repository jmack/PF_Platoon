        '========================================================================';        
        private _lastActionIndex = _v getVariable ['RNL_lastActionIndex', -1];
        if (_index > _lastActionIndex) then {
            _v setVariable ['RNL_lastActionIndex', _index];
            
            '--- LOEST SCHUESSE 0.5 SEKUNDE FRUEHER (AUS DER ZUKUNFT) AUS ---';
            private _offsetFrames = round (0.5 / _fps);
