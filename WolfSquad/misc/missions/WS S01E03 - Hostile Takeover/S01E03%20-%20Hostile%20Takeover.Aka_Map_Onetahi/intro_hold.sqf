                    if (_actName == 'GetOut' || _actName == 'Eject') exitWith { if (_actName == 'Eject' && {isClass (configOf _v >> 'EjectionSystem')}) then { _isEjection = true; [_v] spawn BIS_fnc_planeEjection; } else { _isGettingOut = true; _logicPilot actionNow [_actName, _v]; }; };

                    if (_actName == 'UnloadAllVehicles') exitWith { { objNull setVehicleCargo _x; } forEach (getVehicleCargo _v); };

                    if (_actName == 'RNL_RAPPEL_TROOPS') exitWith {
                        
                        '1. Playback pausieren (Friert Heli in der Luft ein)';
                        _v setVariable ['RNL_PAUSE_RESUME', true, true];

                        '2. Thread abspalten, da EachFrame kein Sleep zulaesst';
                        [_v, _fnc_name, _oldGrps, _agentPilot, _coPilot, _gunnerPilot, _fnc_doRappel] spawn {
                            params ['_v', '_fnc_name', '_oldGrps', '_agentPilot', '_coPilot', '_gunnerPilot', '_fnc_doRappel'];

                            'Infanterie filtern und sortieren (Leader zuerst, keine Klon-Crew)';
                            private _leaders = [];
                            private _subordinates = [];

                            {
                                if (alive _x && {!(_x in [_agentPilot, _coPilot, _gunnerPilot])} && {group _x != _oldGrps}) then {
                                    if (leader group _x == _x) then { _leaders pushBack _x; } else { _subordinates pushBack _x; };
                                };
                            } forEach (crew _v);
                        
                            private _troops = _leaders + _subordinates;

                            if (count _troops > 0) then {
                                _v setVariable ['RNL_activeRappellers', count _troops];

                                private _checkedGroups = [];
                                {
                                    private _grp = group _x;
                                    if !(_grp in _checkedGroups) then {
                                        _checkedGroups pushBack _grp;
                                        'Wenn die Gruppe JETZT (im Heli) noch offene Wegpunkte hat, merken wir uns das!';
                                        private _hasWPs = (currentWaypoint _grp < count waypoints _grp);
                                        _grp setVariable ['RNL_groupHadWaypoints', _hasWPs, true];
                                    };
                                } forEach _troops;

                                'Die eigentliche Ausfuehrung: Soldaten im 2-Sekunden-Takt von ihren Sitzen abseilen';
                                {
                                    '1. Visuelle Weltposition des Soldaten ermitteln, waehrend er noch im Sitz sitzt';
                                    private _unitWorldPos = getPosATLVisual _x;

                                    '2. Weltposition in das relative Modell-Offset des Helis umrechnen';
                                    private _dynamicSeatOffset = _v worldToModelVisual _unitWorldPos;

                                    '3. Abseilprozess starten und das dynamische Offset uebergeben';
                                    [_x, _v, _dynamicSeatOffset] spawn _fnc_doRappel;
                                    
                                    sleep 2;
                                } forEach _troops;

                                'Warten, bis alle Einheiten den Boden beruehrt haben oder Heli zerstoert wird';
                                waitUntil { sleep 0.5; !alive _v || {(_v getVariable ['RNL_activeRappellers', 0]) <= 0} };
                            };

                            '3. Playback wieder aufnehmen';
                            _v setVariable ['RNL_PAUSE_RESUME', false, true];
                        };
                    };

                    if (_actName == 'RNL_UNLOAD_TROOPS') exitWith { 
                        
                        'Fahrzeug-Fracht (VIV - Kisten/Fahrzeuge) sofort entladen (Loest keine Pause aus)';
                        { objNull setVehicleCargo _x; } forEach (getVehicleCargo _v);
                        
                        'Infanterie filtern';
                        private _troops = (crew _v) select {alive _x && {!(_x in [_agentPilot, _coPilot, _gunnerPilot])} && {group _x != _oldGrps}};
                        
                        'Infanterie nacheinander ausladen oder abwerfen';
                        if (_troops isNotEqualTo []) then { 
                            
                            'Pruefen: Befinden wir uns ueber 60m? Dann ist es ein Paradrop (Keine Pause). Darunter: Ground Unload (Pause)';
                            private _vehPos = getPosASL _v;
                            private _groundPos = lineIntersectsSurfaces [_vehPos, _vehPos vectorAdd [0, 0, -60], _v, objNull, true, 1, 'GEOM', 'NONE'];
                            private _isParadrop = (count _groundPos == 0);

                            [_troops, _v, _isParadrop, _fnc_name] spawn { 
                                params ['_troops', '_v', '_isParadrop', '_fnc_name']; 
                                
                                'PLAYBACK PAUSIEREN (Nur bei Ground-Unload)';
                                if (!_isParadrop) then {
                                    _v setVariable ['RNL_PAUSE_RESUME', true, true];
                                };

                                private _grps = []; 
                                { 
                                    if (alive _x && {vehicle _x == _v}) then { 
                                        private _delay = 0.5;
                                        moveOut _x;
                                        group _x leaveVehicle _v; 
                                        unassignVehicle _x;

                                        'PARADROP LOGIK (Hoehe > 60m)';
                                        if (_isParadrop) then { 
                                            _delay = 0.5;
                                            [_x] spawn {
                                                params ['_unit'];
                                                _unit disableAI 'ANIM';
                                                while {alive _unit && {vehicle _unit == _unit} && {(getPosVisual _unit) # 2 > 60}} do { 
                                                    private _currentAnim = toLower (animationState _unit);

                                                    if (_currentAnim find 'halofreefall' == -1) then { _unit switchMove 'HaloFreeFall_B'; };
                                                    sleep 0.1; 
                                                };
                                                
                                                if (alive _unit && {vehicle _unit == _unit}) then {
                                                    private _parachute = createVehicle ['Steerable_Parachute_F', getPosVisual _unit, [], 0, 'NONE'];
                                                    _parachute setPhysicsCollisionFlag false;
                                                    _unit moveInDriver _parachute;
                                                    _unit enableAI 'ANIM';
                                                };
                                            };
                                        };
                                        
                                        private _g = group _x; 
                                        if !(_g in _grps) then { 
                                            _grps pushBack _g; 
                                            
                                            'Eigener WP wird nur erstellt, wenn keine weiteren Wegpunkte existieren, 
                                            um ein eigenmaechtiges Folgen des Fahrzeugs zu verhindern';
                                            if (currentWaypoint _g >= count waypoints _g) then {
                                                while {count (waypoints _g) > 0} do { deleteWaypoint [_g, 0]; }; 
                                                private _wp = _g addWaypoint [_v getPos [10, random 360], 0]; 
                                                _wp setWaypointType 'MOVE'; 
                                                _wp setWaypointBehaviour 'AWARE'; 
                                                _g setCurrentWaypoint _wp; 
                                            }; 
                                        }; 
                                        
                                        sleep _delay; 
                                    }; 
                                } forEach _troops; 

                                'PLAYBACK FORTSETZEN (Nur wenn wir vorher pausiert haben)';
                                if (!_isParadrop) then {
                                    _v setVariable ['RNL_PAUSE_RESUME', false, true];
                                };
                            }; 
                        };
                    };
                    _logicPilot actionNow [_actName, _v];
                };
            } forEach _actions;
        };
        
        '========================================================================';
        'EJECTION-HANDLER: Wiederherstellung der KI-Einheiten nach Ausstieg';
        '========================================================================';
        if (_isEjection || _isGettingOut) exitWith {

            _v setVariable ['out_newPilot',false];

            deleteVehicle _logicPilot; 
            deleteVehicle _agentPilot;
            deleteVehicle _coPilot;

            'CLEANUP MANAGEMENT: Loescht Fahrzeug & Crew falls ausgeloest';
            if (_RNL_wipeOut || (_v getVariable ['RNL_wipeOut', false])) exitWith {
                
                _v setVariable ['RNL_AIR_END', true, true];
                call _RNL_CLEANUP;
                
                [_v, _oldGrps] spawn {
                    params ['_v', '_oldGrps'];
                    sleep 1.5;
                    { deleteVehicle _x; } forEach (units _oldGrps);
                    { deleteVehicle _x; } forEach (crew _v);
                    deleteVehicle _v;
                    deleteGroup _oldGrps;
                };
            };
            
            private _outPilot = _oldGrps createUnit [_typeOne, [0,0,0], [], 0, 'NONE'];
            _v lockDriver false;
            _outPilot moveInDriver _v;

            if (_loadout isNotEqualTo []) then { _outPilot setUnitLoadout _loadout; };

            if (_hadCopilot) then {
                private _endCoPilot = _oldGrps createUnit [_typeOne, [0,0,0], [], 0, 'NONE'];
                _endCoPilot moveInTurret [_v, _coPilotTurretPath];
                if (_loadout isNotEqualTo []) then { _endCoPilot setUnitLoadout _loadout; };
            };

            if (_isGettingOut) then {

                'Aussteigen und neuen Wegpunkt nur setzen, wenn keine anderen Wegpunkte existieren';
                private _hadWaypoints = _oldGrps getVariable ['RNL_groupHadWaypoints', false];
                private _wpsIndex = _oldGrps getVariable ['RNL_wpsIndex', 1];

                _oldGrps leaveVehicle _v; {moveOut _x;} forEach (units _oldGrps);

                if (!_hadWaypoints && {currentWaypoint _oldGrps >= count waypoints _oldGrps}) then {
                    while {count (waypoints _oldGrps) > 0} do { deleteWaypoint [_oldGrps, 0]; };
                    private _wp = _oldGrps addWaypoint [_v getPos [5, (getdir _v)], 0];
                    _wp setWaypointCompletionRadius 5;
                    _wp setWaypointType 'MOVE';
                    _wp setWaypointBehaviour 'AWARE';
                    _oldGrps setCurrentWaypoint _wp;
                } else { 
                    _oldGrps setCurrentWaypoint [_oldGrps, _wpsIndex]; 
                };
            };

            _oldGrps deleteGroupWhenEmpty true;
            _v setVariable ['RNL_AIR_END', true, true];
            call _RNL_CLEANUP;
        };

        '========================================================================';
        'EXIT-CONDITIONS: Abschluss des Playbacks bei Zerstoerung oder Ende';
        '========================================================================';
        if (!alive _v) exitWith { call _RNL_CLEANUP; _oldGrps deleteGroupWhenEmpty true; deleteVehicle _logicPilot; deleteVehicle driver _v; deleteVehicle _coPilot; };
        if (_index >= _totalFrames - 1 || _v getVariable ['RNL_PLAYBACK_DONE', false]) exitWith { _oldGrps deleteGroupWhenEmpty true; call _RNL_CLEANUP; };
    }, 
    [ _v, _data, _fps, _startTime, _totalFrames, _logicPilot, _agentPilot, _coPilot, _gunnerPilot, _hadCopilot, _coPilotTurretPath, 
	_oldGrps, _typeOne, _loadout, _LaserTargetC, _realGunner, _isEjection, _isGettingOut, _recSide, _fnc_doRappel, 
	_CamEnable, _Offset_Camera, _Cam_look_Sphere, _playCam, _Cam_look_Self, _Camera_setFov, _Cam_look_Bullet, _Offset_Bullet,
	_RNL_PPeffect, _ppBlury1, _ppColor2, _ppColor3, _ppGrain4, _Cam_Rotation, _RNL_Shake, _RNL_Shake_power, _RNL_wipeOut
    ]];

    _v setVariable ['RNL_Playback_EH', _RNL_EH_ID];
    
    _v setVariable ['RNL_PLAYBACK_DONE', false];
    waitUntil { sleep 0.1; _v getVariable ['RNL_PLAYBACK_DONE', false] };
    
    '========================================================================';
    'REINTEGRATION: Wiederherstellung der urspruenglichen KI-Besatzung, kein Ausstieg';
    '========================================================================';
    if (_v getVariable ['out_newPilot',true] && alive _v) then {

        deleteVehicle _logicPilot; 
        deleteVehicle _agentPilot;
        deleteVehicle _coPilot;
        
        private _endPilot = _oldGrps createUnit [_typeOne, [0,0,0], [], 0, 'NONE'];
        
        'UAV PRUEFUNG: Wenn ein echter Driver-Sitz frei ist, direkt rein';
        if (unitIsUAV _v) then {

            _v lockDriver false;
            _endPilot moveInAny _v;

        } else {

            _v lockDriver false;
            _endPilot moveIndriver _v;
            if (_loadout isNotEqualTo []) then { _endPilot setUnitLoadout _loadout; }; 
        };

        'PRUEFUNG: Wenn ein echter CoPiloten-Sitz frei ist, direkt rein';
        if (_hadCopilot) then {
            private _endCoPilot = _oldGrps createUnit [_typeOne, [0,0,0], [], 0, 'NONE'];
            _endCoPilot moveInTurret [_v, _coPilotTurretPath];
            if (_loadout isNotEqualTo []) then { _endCoPilot setUnitLoadout _loadout; };
        };

        'Eigener WP wird nur erstellt, wenn keine weiteren Wegpunkte existieren ansonsten gespeicherte Wegpunkte benutzen';
        'Es wird auch kein WP erstellt, wenn das Fahrzeug gelandet worden ist aber man noch drin sitzt';
        private _hadWaypoints = _oldGrps getVariable ['RNL_groupHadWaypoints', false];
        private _wpsIndex = _oldGrps getVariable ['RNL_wpsIndex', 1];

        '( [Es war leer] ODER [Es gibt keine offenen WPs mehr] ) UND ( Heli fliegt )';
        if ((_emptyWP || {currentWaypoint _oldGrps >= count waypoints _oldGrps}) && {!isTouchingGround _v}) then {

            while {count (waypoints _oldGrps) > 0} do { deleteWaypoint [_oldGrps, 0]; };
            private _wp = _oldGrps addWaypoint [_v getPos [5, (getdir _v)], 0];
            _v setEffectiveCommander _endPilot;
            _wp setWaypointCompletionRadius 10;
            _wp setWaypointType 'LOITER';
            _wp setWaypointBehaviour 'AWARE';
            _oldGrps setCurrentWaypoint _wp;
            _oldGrps deleteGroupWhenEmpty true;

        } else { 

            _v setEffectiveCommander _endPilot;
            _oldGrps setCurrentWaypoint [_oldGrps, _wpsIndex];
            _oldGrps deleteGroupWhenEmpty true; 
        };

        _v setVariable ['RNL_PLAYBACK_DONE', nil];
        _v setVariable ['RNL_AIR_END', true, true];

        sleep 1.5;

        'CLEANUP MANAGEMENT: Loescht Fahrzeug & Crew falls ausgeloest';
        if (_RNL_wipeOut || (_v getVariable ['RNL_wipeOut', false])) then {

            {deleteVehicle _x;} forEach (units _oldGrps);
            {deleteVehicle _x;} forEach (crew _v);
            deleteVehicle _v;
            deleteGroup _oldGrps;
        };

        if (!isNull _v) then {
            _v setVariable ['RNL_PLAYBACK_DONE', nil];
            _v setVariable ['RNL_AIR_END', true, true];
        };
    };
};
