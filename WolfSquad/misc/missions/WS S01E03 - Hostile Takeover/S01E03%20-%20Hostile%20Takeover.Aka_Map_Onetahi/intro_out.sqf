
intro_pelican spawn {
'
Build by: ReNe Lammers
Origin: Germany

--- PLAYBACK START (SQF) ---
[AIRCRAFT_NAME] execVM "SQF_NAME.sqf";

--- PLAYBACK START (Trigger) ---
Replace script start -> _this <- with your AIRCRAFT NAME.

--- PAUSE - RESUME - FINISH - CLEANUP - CAMERA ---
Replace -> NAME <- with the actual variable name of your aircraft from the editor.

--- PAUSE PLAYBACK ---
Name setVariable ["RNL_PAUSE_RESUME", true, true];

--- RESUME PLAYBACK ---
Name setVariable ["RNL_PAUSE_RESUME", false, true];

--- FINISH PLAYBACK EARLY --- 
Name setVariable ["RNL_PLAYBACK_DONE", true, true];

--- CLEANUP MANAGEMENT ---';
private _RNL_wipeOut = false;    'true = Deletes vehicle & crew immediately after playback ends';

'--- ENABLE CLEANUP MID-PLAYBACK ---
Name setVariable ["RNL_wipeOut", true, true];

--- DETECT PLAYBACK END (TRIGGER CONDITION) ---
Want to trigger an event exactly when the flight is finished, the crew ejects, or the vehicle is destroyed?
Use this condition in an Editor Trigger:
Name getVariable ["RNL_AIR_END", false];

- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

--- START THE CAMERA WHENEVER YOU WANT ---
Name setVariable ["RNL_CAM_START", true];

--- STOP CAMERA EARLY ---
Name setVariable ["RNL_CAM_DONE", true, true];

--- OPTIONAL: CINEMATIC CAMERA SETTINGS ---';
private _CamEnable       = false;     'true = Enable Camera directly';
private _Offset_Camera = [0, -14, 3]; 'Default Cam [X (Left/Right), Y (Forward/Backward), Z (Up/Down)]';
private _Offset_Bullet = [0, -14, 3]; 'Bullet  Cam [X (Left/Right), Y (Forward/Backward), Z (Up/Down)]';
private _Camera_setFov   = 0.75;      'Cam Zoom - (0.75 default)';
private _RNL_Shake_power = 0.004;     'RNL Shake Effect Power (0.004 default)';
private _RNL_Shake       = false;     'true = Enable RNL Shake Effect';
private _RNL_PPeffect    = false;     'true = Enable RNL PP Effect';
private _Cam_look_Self   = false;     'true = Cam locks onto Aircraft';
private _Cam_look_Sphere = false;     'true = Cam locks onto Yellow recording sphere';
private _Cam_look_Bullet = false;     'true = Enable Bullet Cam | Compatible with locks onto Aircraft or Yellow recording sphere';
private _Cam_Rotation    = false;     'true = Cam stays level with the Horizon | false = Camera rolls/pitches with aircraft';
          showCinemaBorder false;     'true = Enable Cinema Border';
                 camusenvg false;     'true = Enable Night Vision';
