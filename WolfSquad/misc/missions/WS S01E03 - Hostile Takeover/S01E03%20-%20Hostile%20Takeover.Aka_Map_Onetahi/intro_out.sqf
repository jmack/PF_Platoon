        _coPilot moveInTurret [_v, _freeCopilots # 0];
        _coPilot setUnitLoadout _loadout;
        _coPilot enableSimulation false;
        _coPilot setDamage 1;
        _coPilot setDamage 0;
        removeFromRemainsCollector [_coPilot];
        _hadCopilot = true;
    };

    '========================================================================';
    'GUNNER-BESETZUNG: Dynamische Zuweisung von freien Turret-Plaetzen';
    '========================================================================';
    if (!unitIsUAV _v && _emptyWP) then {
        private _allSeats = fullCrew [_v, '', true];
        private _gunnerCount = 0;
        
        {
            'Sobald 2 Gunner besetzt wurden, brechen wir die Schleife komplett ab.
            Kann man auch erhoehen, hat nur Auswirkung auf leere Fahrzeuge';
            if (_gunnerCount >= 2) exitWith {};

            _x params ['_unitInSeat', '_role', '_cargoIndex', '_turretPath', '_isPersonTurret'];

            'Bedingung 1: Der Platz muss leer sein (isNull _unitInSeat)
             Bedingung 2: Der Platz MUSS einen Turret-Pfad haben (_turretPath isNotEqualTo [])
             Bedingung 3: Der Platz darf KEIN FFV-Passagiersitz sein (!_isPersonTurret)';

            if (isNull _unitInSeat && {_turretPath isNotEqualTo []} && {!_isPersonTurret}) then {
                '1. Die neue Einheit erstellen';
                private _gunnerPilot = _oldGrps createUnit [_typeOne, [0,0,0], [], 0, 'NONE'];
                '2. Einheit exakt auf diesen Turret-Pfad setzen';
                _gunnerPilot moveInTurret [_v, _turretPath];
                '3. Loadout zuweisen';
                if (_loadout isNotEqualTo []) then { _gunnerPilot setUnitLoadout _loadout; };
                '4. Zaehler erhoehen, da erfolgreich ein Gunner platziert wurde';
                _gunnerCount = _gunnerCount + 1;
            };
        } forEach _allSeats;
    };
    
    '========================================================================';
    'GEAR & ROTOR: Einzug des Fahrwerks & Rotorstart bei Flugstart';
    '========================================================================';
    if (count _data > 0) then {
        private _firstFrame = _data # 0;

		_v setPosASL _firstFrame # 1;

        sleep 0.05;

        'Erkennt, ob die Aufzeichnung in der Luft begann, das Fahrzeug vor der Wiedergabe 
        jedoch auf dem Boden/Flugzeugtraeger platziert wurde.';
		private _startpos = getPosASL _v;
        private _intersections = lineIntersectsSurfaces [_startpos, _startpos vectorAdd [0, 0, -5], _v, objNull, true, 1, 'GEOM', 'NONE'];

		if (count _intersections == 0) then {
			_v setVehiclePosition [_firstFrame # 1, [], 0, 'FLY'];
		};
    };

    '========================================================================';
    'SETUP: Gunner-Unterdrueckung und Erstellung der Ziel-Objekte';
    '========================================================================';
    private _LaserTargetC = createVehicleLocal ['LaserTargetC', [0,0,0], [], 0, 'CAN_COLLIDE'];
    _LaserTargetC enableSimulation false; 'Vor dem Loeschen schuetzen';
    _v setVariable ['RNL_myRNLtarget', _LaserTargetC];
    
    private _fnc_name = vehicleVarName _v;
    private _realGunner = gunner _v;
    if (!isNull _realGunner) then {
        _v setEffectiveCommander _realGunner;
        { _realGunner disableAI _x } forEach ['TARGET', 'AUTOTARGET', 'FIREWEAPON'];
    };
    
    _v setVariable ['RNL_AIR_END', false, true];
    
    '========================================================================';
    'FIRED-EH: Lenkung von Bomben und Raketen durch Target-Lock';
    '========================================================================';
    _v setVariable ['RNL_Playback_Fired_EH', _v addEventHandler ['Fired', {
        params ['_unit', '_weapon', '_muzzle', '_mode', '_ammo', '_magazine', '_projectile', '_gunner'];
        private _myRNLtarget = _unit getVariable ['RNL_myRNLtarget', objNull];
        private _lockData = _unit getVariable ['RNL_currentLock', ['NONE', [], [0,0,0]]];
		private _isBulletActive = _unit getVariable ['RNL_Bullet_Cam_Active', false];
        _lockData params ['_lockType', '_targetInfo', '_targetPos'];

        if (!_isBulletActive && !isNull _projectile && (_projectile isKindOf 'BombCore' || _projectile isKindOf 'MissileCore')) then { 
			_unit setVariable ['RNL_Bullet_Cam', _projectile]; 
			_unit setVariable ['RNL_Bullet_Cam_Active', true]; 
		};
        
        if (_projectile isKindOf 'BombCore' && _lockType != 'OBJECT') exitWith {
        
            if (_lockType == 'LASER') then {
            
                _projectile setMissileTargetPos (ASLToATL _targetPos);
            } else { 
                _projectile setMissileTarget objNull;
            };
        };

        if (_projectile isKindOf 'MissileCore' && _lockType != 'OBJECT') exitWith {

            if (_lockType == 'LASER') then {

                _projectile setMissileTarget _myRNLtarget;
            };
        };

        if (_lockType == 'OBJECT' && {_targetInfo isNotEqualTo []}) exitWith {
            _targetInfo params ['_tType', '_tPos'];
            
            private _foundTargets = nearestObjects [_tPos,[_tType],50];
            if (count _foundTargets > 0) then {
            
                _projectile setMissileTarget (_foundTargets # 0);
            } else {
                _projectile setMissileTargetPos (ASLToATL _tPos);
            };
        };
    }]];

    '========================================================================';
    'BOARDING: KI, Player, Gruppenmitglieder: Scan-> (WP: GETIN + 20m Radius)';
    '========================================================================';
    [_v, _recSide, _fnc_name] spawn {
        params ['_v', '_recSide', '_fnc_name'];

        while {alive _v && !(_v getVariable ['RNL_AIR_END', false])} do {
            
            {
                private _gruppe = _x;
                private _currentWP = currentWaypoint _gruppe;

                'Pruefen: Hat die Gruppe aktuell einen GETIN-Wegpunkt auf unserem Heli?';
                if (_currentWP < count (waypoints _gruppe)) then {
                    
                    'Heli muss den Boden beruehren (Oder < 1m Hoehe haben) UND darf nicht schneller als 5km/h sein';
                    if (waypointAttachedVehicle [_gruppe, _currentWP] == _v && {waypointType [_gruppe, _currentWP] == 'GETIN'} && {!(_gruppe getVariable ['RNL_isBoarding', false])} && {(isTouchingGround _v || (getPosVisual _v select 2) < 1)} && {speed _v < 5}) then {

                        '1. Heli pausiert SOFORT und wartet auf die Truppen (Kein Wegfliegen!)';
                        _gruppe setBehaviour 'AWARE';
                        _gruppe setSpeedMode 'FULL';
                        _gruppe setVariable ['RNL_isBoarding', true];
                        {_x assignAsCargo _v} forEach (units _gruppe);
                        (units _gruppe) orderGetIn true; 
                        _v setVariable ['RNL_PAUSE_RESUME', true, true];

                        '2. Eigener Thread uebernimmt das Warten und Einsteigen';
                        [_gruppe, _v, _currentWP, _fnc_name] spawn {
                            params ['_gruppe', '_v', '_currentWP', '_fnc_name'];
                            
                            private _leader = leader _gruppe;
                            
                            'Warteschleife: Thread wartet im Hintergrund, bis der Leader auf 20m heran ist';
                            waitUntil { 
                                sleep 1; 
                                !alive _v || !alive _leader || (_leader distance2D _v <= 20) || (vehicle _leader == _v)
                            };

                            if (!alive _v) exitWith {};

                            '3. SPRINT-PHASE (20m -> 6m)';
                            private _units = (units _gruppe) select {alive _x && {vehicle _x == _x}};
                            
                            'Hier greift der geniale Animation-Lock: Sie bleiben in der Lauf-Schleife gefangen';
                            {
                                _x disableAI 'ANIM';
                                _x switchmove 'AmovPercMevaSlowWrflDf';
                                _x setDir (_x getDir _v);
                            } forEach _units;

                            'Schleife: Ueberwache die Distanz jeder Einheit (0.1s Intervall)';
                            while {count _units > 0 && {alive _v}} do {
                                
                                _units = _units select {alive _x};
                                private _toRemove = [];
                                
                                {
                                    private _u = _x;
									private _targetDir = _u getdir _v;
									private _currentDir = getdir _u;
									private _diff = abs (_currentDir - _targetDir);

									if (_diff > 180) then {_diff = 360 - _diff};
									if (_diff > 1) then { _u setdir _targetDir;};
                                    if (_u distance2D _v <= 3.5) then {
                                        if ((_v emptyPositions 'cargo') > 0) then {
                                            _u setBehaviour 'AWARE';
                                            _u switchmove '';
                                            _u enableAI 'ANIM';
                                            _u moveInCargo _v;
                                        } else {
                                            _units = [];
                                        };
                                        _toRemove pushBack _u;
                                    };
									
                                } forEach _units;
                                
                                _units = _units - _toRemove;
                                sleep 0.1; 
                            };

                            '4. ABSCHLUSS';
                            'Sicherheitsnetz: ALLE Einheiten der Gruppe auf jeden Fall wieder aufwachen lassen';
                            { _x enableAI 'ANIM'; } forEach (units _gruppe);

                            if (_currentWP > 0 && {waypointType [_gruppe, _currentWP] == 'GETIN'}) then {
                                _gruppe setCurrentWaypoint [_gruppe, _currentWP + 1];
                            };
                            
                            'Heli-Playback fortsetzen';
                            _gruppe setVariable ['RNL_isBoarding', false];
                            _v setVariable ['RNL_PAUSE_RESUME', false, true];
                        };
                    };
                };
            } forEach allGroups;     
            sleep 1; 
        };
    };

    '========================================================================';
    'RAPPEL-SYSTEM: Hilfsfunktion fuer das Abseilen einzelner Einheiten';
    '========================================================================';
    private _fnc_doRappel = {
        params ['_unit', '_heli', '_offset'];

        'Kollision abschalten, Einheit zwingen auszusteigen';
        _unit setVariable ['RNL_isRappelling', true];
        _unit setphysicscollisionflag false;
        _unit allowDamage false;
        _unit leaveVehicle _heli;
        unassignVehicle _unit;
        moveOut _unit;
        waitUntil {vehicle _unit == _unit};

        'Oberflaechen-Erkennung (Zentral unter dem Heli)';
        private _aircraftPosASL = AGLToASL (_heli modelToWorldVisual _offset);
        private _centerASL = AGLToASL (_heli modelToWorldVisual [0,0,0]);
        private _rayEndASL = _centerASL vectorAdd [0, 0, -150]; 
        
        private _surfaces = lineIntersectsSurfaces [_centerASL, _rayEndASL, _heli, _unit, true, 1, 'VIEW', 'NONE'];
        private _surfaceZ = getTerrainHeightASL _centerASL;
        if (count _surfaces > 0) then { _surfaceZ = (_surfaces # 0 # 0) # 2; };
        if (_surfaceZ < 0) then { _surfaceZ = 0; };

        private _ropeLength = (_aircraftPosASL # 2) - _surfaceZ;

        'Schutzschaltung: Zu nah am Boden';
        if (_ropeLength < 2) exitWith {
            _unit setVariable ['RNL_isRappelling', false];
            _unit allowDamage true;
        };

        'Vanilla Animation & KI-Status';
        _unit switchMove 'passenger_inside_3_Obstructed';

        'Seil direkt vom Heli aus erstellen';
        private _rope = ropeCreate [_heli, _offset, 1];
        _rope setphysicscollisionflag false;
        private _anker = 'Land_Can_V2_F' createVehicle [0, 0, 0];
        _anker setphysicscollisionflag false;
        _anker setObjectTextureGlobal [0, ''];

        'Einheit direkt physikalisch an das Seil binden';
        [_anker, [0, 0.4, 0.5]] ropeAttachTo _rope;
        [_anker, 15, 0] call BIS_fnc_setPitchBank;
        _unit attachTo [_anker, [0, - 0.1, -0.1]];

        'Abseil-Phasen (Sanftes Beschleunigen)';
        ropeUnwind [_rope, 1, _ropeLength]; sleep 0.5;
        ropeUnwind [_rope, 3, _ropeLength]; sleep 0.5;
        ropeUnwind [_rope, 5, _ropeLength];

        'Sink-Schleife (Mit Stillstands-Erkennung)';
        private _lastZ = getPosASL _unit # 2;
        private _stuckCounter = 0;

        while {alive _unit && {_unit getVariable ['RNL_isRappelling', false]}} do {
            private _currentZ = getPosASL _unit # 2;
            if (_currentZ <= _surfaceZ + 1) exitWith {};
            if (abs (_lastZ - _currentZ) < 0.1) then { _stuckCounter = _stuckCounter + 1; } else { _stuckCounter = 0; };
            if (_stuckCounter > 5) exitWith { _surfaceZ = _currentZ; };
            _lastZ = _currentZ;
            sleep 0.1; 
        };

        'LANDUNG & CLEANUP';
        _unit switchMove '';
        ropeDestroy _rope;
        deleteVehicle _anker;

        'Einheit exakt auf das Dach setzen (Verhindert, dass sie in das Haus clippt)';
        private _finalPos = getPosASL _unit;
        _finalPos set [2, _surfaceZ + 0.03];
        _unit setPosASL _finalPos;
        _unit setVariable ['RNL_isRappelling', false];
        _unit setphysicscollisionflag true;
        _unit allowDamage true;

        'Aktive Abseiler des Helis verringern';
        private _activeRappellers = _heli getVariable ['RNL_activeRappellers', 0];
        _heli setVariable ['RNL_activeRappellers', (_activeRappellers - 1) max 0];

        'KI ABKOPPELN UND WEGSCHICKEN';
        if (alive _unit && !isPlayer _unit) then {
            unassignVehicle _unit;
            [_unit] allowGetIn false; 
            
            private _g = group _unit;
            if (leader _g == _unit) then {
                
                'NEU: Wir holen uns das Gedaechtnis aus der Gruppe';
                private _hadWaypoints = _g getVariable ['RNL_groupHadWaypoints', false];
                
                'Pruefen: NUR wenn die Gruppe keine Wegpunkte hatte wird einer erstellt';
                if (!_hadWaypoints && {currentWaypoint _g >= count waypoints _g}) then {
                    
                    private _wp = _g addWaypoint [getPosASL _unit, -1];
                    _wp setWaypointCompletionRadius 10;
                    _wp setWaypointType 'MOVE';
                    _wp setWaypointBehaviour 'AWARE';
                    _g setCurrentWaypoint _wp;
                };
            };
        };
    };

    '=========================================================================';
    'LOGIC BLOCK (Text Intro)';
    '=========================================================================';
    if (_textEnabled) then {
        [
            _fontTitle, _fontSub, _line1_size, _line1_color, _line1_text, _line2_size, _line2_color, _line2_text, _line3_size, _line3_color, _line3_text, _delayBeforeStart, _screenX, _screenY, _duration, _fadeInTime, _deltaY, _rscLayer
        ] spawn {
            params ['_fontTitle', '_fontSub', '_line1_size', '_line1_color', '_line1_text', '_line2_size', '_line2_color', '_line2_text', '_line3_size', '_line3_color', '_line3_text', '_delayBeforeStart', '_screenX', '_screenY', '_duration', '_fadeInTime', '_deltaY', '_rscLayer'];
            
            sleep _delayBeforeStart;
            
            [
                ('<t font=''' + _fontTitle + ''' size=''' + _line1_size + ''' color=''' + _line1_color + '''>' + _line1_text + '</t><br/>' +
                 '<t font=''' + _fontSub + ''' size=''' + _line2_size + ''' color=''' + _line2_color + '''>' + _line2_text + '</t><br/>' +
                 '<t font=''' + _fontSub + ''' size=''' + _line3_size + ''' color=''' + _line3_color + '''>' + _line3_text + '</t>'),
                _screenX,
                _screenY,
                _duration,
                _fadeInTime,
                _deltaY,
                _rscLayer
            ] spawn BIS_fnc_dynamicText; 
        };
    };
    
    '========================================================================';
    'EVENT-INITIALISIERUNG: Registrierung der EachFrame-Schleife';
    '========================================================================';
	private _playCam  = objNull;
	private _ppBlury1 = objNull;
	private _ppColor2 = objNull;
	private _ppColor3 = objNull;
	private _ppGrain4 = objNull;    
    private _startTime = Time;
    private _totalFrames = count _data;
    private _RNL_EH_ID = addMissionEventHandler ['EachFrame', {
        private _args = _thisArgs;
        _args params [
        '_v', '_data', '_fps', '_startTime', '_totalFrames', '_logicPilot', '_agentPilot', '_coPilot', '_gunnerPilot', '_hadCopilot', '_coPilotTurretPath', 
        '_oldGrps', '_typeOne', '_loadout', '_LaserTargetC', '_realGunner', '_isEjection', '_isGettingOut', '_recSide', '_fnc_doRappel',
        '_CamEnable', '_Offset_Camera', '_Cam_look_Sphere', '_playCam', '_Cam_look_Self', '_Camera_setFov', '_Cam_look_Bullet', '_Offset_Bullet',
		'_RNL_PPeffect', '_ppBlury1', '_ppColor2', '_ppColor3', '_ppGrain4', '_Cam_Rotation', '_RNL_Shake', '_RNL_Shake_power', '_RNL_wipeOut'
        ];
        
        '========================================================================';
        'PAUSE-FUNKTION: Friert das Playback ein und managet die Zeitverschiebung';
        '========================================================================';
        private _fnc_name = vehicleVarName _v;
        private _isPaused = _v getVariable ['RNL_PAUSE_RESUME', false];
        private _wasPaused = _v getVariable ['RNL_wasPaused', false];

        if (_isPaused && alive _v) exitWith {
            'Einmaliger Trigger beim Start der Pause';
            if (!_wasPaused) then {
                _v setVariable ['RNL_wasPaused', true];
                _v setVariable ['RNL_pauseStartTime', time];
            };
            
            '--- ANTI-GRAVITY HOLD (HOVER HACK) ---';
            'Liest die exakte Position des letzten aktiven Frames aus und nagelt das Fahrzeug fest';
            private _pauseTransform = _v getVariable ['RNL_Pause_Transform', [getPosASL _v, vectorDir _v, vectorUp _v]];
            _v setPosASL (_pauseTransform # 0);
            _v setVectorDirAndUp [_pauseTransform # 1, _pauseTransform # 2];
            _v setVelocity [0,0,0];
        };

        'Einmaliger Trigger beim Beenden der Pause: Gesamtpausenzeit der Startzeit anrechnen';
        if (_wasPaused) then {
            _v setVariable ['RNL_wasPaused', false];
            private _timeSpentPaused = time - (_v getVariable ['RNL_pauseStartTime', time]);
            
            'WICHTIG: Aktualisiere ZUERST die lokale Variable fuer diesen Frame...';
            _startTime = _startTime + _timeSpentPaused;
            
            '... und schreibe sie DANN in das Event-Array fuer alle kommenden Frames zurueck.';
            _args set [3, _startTime];
        };

        '========================================================================';
        'CAMERA EARLY STOP: Beendet nur die Kamera, waehrend der Flug weitergeht';
        '========================================================================';
        if (!isNull _playCam && {_v getVariable ['RNL_CAM_DONE', false]}) then {

            _v setVariable ['RNL_CAM_DONE', false];

            _playCam cameraEffect ['terminate', 'back'];
            camDestroy _playCam;
            _args set [23, objNull];

			if (_RNL_PPeffect) then { 
				ppEffectDestroy _ppBlury1; 
				ppEffectDestroy _ppColor2; 
				ppEffectDestroy _ppColor3; 
				ppEffectDestroy _ppGrain4; 
			};
        };

        '========================================================================';
        'CLEANUP-FUNKTION: Entfernt Eventhandler und setzt KI-Status zurueck';
        '========================================================================';
        private _RNL_CLEANUP = {
            private _myID = _v getVariable ['RNL_Playback_EH', -1];
            if (_myID != -1) then { removeMissionEventHandler ['EachFrame', _myID]; };
            if (!isNull _v) then {
                _v removeEventHandler ['Fired', _v getVariable ['RNL_Playback_Fired_EH', -1]];
                _v setVariable ['RNL_currentLock', nil];
            };
            if (!isNull _LaserTargetC) then { deleteVehicle _LaserTargetC; };
            if (!isNull _realGunner && alive _realGunner) then {
                { _realGunner enableAI _x } forEach ['TARGET', 'AUTOTARGET', 'FIREWEAPON'];
                _realGunner doWatch objNull;
                _realGunner doTarget objNull;
            };

            if (!isNull _playCam) then { 
				_playCam cameraEffect ['terminate', 'back'];
				camDestroy _playCam;
                camusenvg false;
                false setCamUseTi 0;
                showCinemaBorder false;

				if (_RNL_PPeffect) then { 
					ppEffectDestroy _ppBlury1; 
					ppEffectDestroy _ppColor2; 
					ppEffectDestroy _ppColor3; 
					ppEffectDestroy _ppGrain4; 
				};
			};

            _v setVariable ['RNL_PLAYBACK_DONE', true];

            { _v lockCameraTo [objNull, _x, false]; } forEach (allTurrets _v);

            enableSaving [true, true];
        };

        '========================================================================';
        'PLAYBACK-INTERPOLATION: Lineare Berechnung der Fahrzeugtransformation';
        '========================================================================';
        private _elapsed = Time - _startTime;
        private _index = _v getVariable ['RNL_PB_Index', 0];

        'Spule vor, bis der naechste Frame unsere aktuelle Zeit ueberschreitet';
        while { _index < _totalFrames - 1 && { (_data # (_index + 1) # 0) < _elapsed } } do { _index = _index + 1; };

        _v setVariable ['RNL_PB_Index', _index];

        if (_index >= _totalFrames - 1) exitWith { call _RNL_CLEANUP; };
        
        private _frameA = _data # _index;
        private _frameB = _data # (_index + 1);

        private _tA = _frameA # 0;
        private _tB = _frameB # 0;
        private _alpha = if (_tB - _tA == 0) then {0} else {((_elapsed - _tA) / (_tB - _tA)) min 1 max 0};
        private _posA = _frameA # 1; private _posB = _frameB # 1;
        private _dirA = _frameA # 2; private _dirB = _frameB # 2;
        private _upA  = _frameA # 3; private _upB  = _frameB # 3; 
        
        _v setPosASL (_posA vectorAdd ((_posB vectorDiff _posA) vectorMultiply _alpha));
        _v setVectorDirAndUp [ 
            _dirA vectorAdd ((_dirB vectorDiff _dirA) vectorMultiply _alpha), 
            _upA  vectorAdd ((_upB vectorDiff _upA)   vectorMultiply _alpha)
        ];
        _v setVelocity (_frameA # 4);
        '--- Wir merken uns die exakte Position fuer eine eventuelle Pause ---';
        _v setVariable ['RNL_Pause_Transform', [getPosASL _v, vectorDir _v, vectorUp _v]];

        '========================================================================';
        'TURRET-TRACKING: Ausrichtung von Ziel-Dummy und Zielerfassung';
        '========================================================================';
        private _gTarget = _frameB # 7;
        if (_gTarget isNotEqualTo [0,0,0]) then {

            _LaserTargetC setPosASL _gTarget;

            {
                private _turretPath = _x;
                private _turretGunner = _v turretUnit _turretPath;
                
                if (!isNull _turretGunner) then {
                    private _turretCfg = [_v, _turretPath] call BIS_fnc_turretConfig;

                    '--- DER HOCHPRAEZISE MASTER-FILTER ---';
                    private _isNotFFV = getNumber (_turretCfg >> 'isPersonTurret') == 0;
                    
                    private _isCopilot = getNumber (_turretCfg >> 'iscopilot') > 0;
                    private _isCommander = getNumber (_turretCfg >> 'primaryObserver') > 0;
                    private _isPrimaryGunner = getNumber (_turretCfg >> 'primaryGunner') > 0;
                    private _isStabilized = getNumber (_turretCfg >> 'stabilizedInAxes') >= 3;
                    
                    private _isMainSystem = (
                        _isCopilot || 
                        _isCommander || 
                        (_isPrimaryGunner && _isStabilized) || 
                        _isStabilized
                    );

                    if (_isNotFFV && _isMainSystem) then {
                        _v lockCameraTo [_LaserTargetC, _turretPath, false]; 
                        _turretGunner reveal [_LaserTargetC, 4]; 
                        _turretGunner doWatch _LaserTargetC; 
                        _turretGunner doTarget _LaserTargetC;
                    } else {
                        _v lockCameraTo [objNull, _turretPath, false]; 
                    };
                } else {
                    _v lockCameraTo [objNull, _turretPath, false]; 
                };
            } forEach (allTurrets _v);

            _agentPilot reveal [_LaserTargetC, 4]; 
            _agentPilot doWatch _LaserTargetC; 
            _agentPilot doTarget _LaserTargetC;
        };

		'========================================================================';
		'KAMERA-INITIALISIERUNG: Erstellt die Kamera falls aktiviert';
		'========================================================================';
		if (_CamEnable || _v getVariable ['RNL_CAM_START', false]) then {
			
            if (!isNull _playCam) then {
                _playCam cameraEffect ['terminate', 'back'];
                camDestroy _playCam;
                if (_RNL_PPeffect) then { 
                    ppEffectDestroy _ppBlury1; ppEffectDestroy _ppColor2; 
                    ppEffectDestroy _ppColor3; ppEffectDestroy _ppGrain4; 
                };
            };

            _args set [23, objNull];
			_playCam = 'camera' camCreate (getPosASL _v);
			_playCam cameraEffect ['internal', 'BACK'];
			_v setVariable ['RNL_CAM_START', false];
			_args set [20, false];
			_args set [23, _playCam];

			if (_RNL_PPeffect) then {

				_ppBlury1 = ppEffectCreate ['radialBlur', 910];
				_ppBlury1 ppEffectEnable true;
				_ppBlury1 ppEffectAdjust [0.005, 0.005, 1, 1];
				_ppBlury1 ppEffectCommit 0;
