														init="if (!isServer) exitWith { };" \n "" \n "this addAction [" \n "  ""Start Mission (all, debug)""," \n "  {" \n "    if (!isServer) exitWith { };" \n "" \n "" \n "    ""// 1: Fade to Black"";" \n "    missionNamespace setVariable [" \n "      ""ace_hearing_disableVolumeUpdate""," \n "      true," \n "      true" \n "    ];" \n "    [0, ""BLACK"", 0.2] remoteExec [""BIS_fnc_fadeEffect""];" \n "    [0.2, 0] remoteExec [""fadeSound""];" \n "" \n "" \n "    ""// 2: Teleport Players"";" \n "    sleep 2;" \n "    _allPlayers = call BIS_fnc_listPlayers;" \n "    {" \n "      if (vehicle _x != _x) then {" \n "        moveOut _x;" \n "      };" \n "      _x moveInCargo intro_pelican;" \n "    } forEach _allPlayers;" \n "" \n "" \n "    ""// 3: Play recording"";" \n "[[intro_pelican],""intro_in.sqf""] remoteExec [""BIS_fnc_execVM"",0,false];" \n "" \n "" \n "    ""// 4: Fade back in"";" \n "    sleep 2;" \n "    setTimeMultiplier 1;" \n "    [1, ""BLACK"", 3] remoteExec [""BIS_fnc_fadeEffect""];" \n "    [3, 1] remoteExec [""fadeSound""];" \n "    sleep 3;" \n "    missionNamespace setVariable [" \n "      ""ace_hearing_disableVolumeUpdate""," \n "      false," \n "      true" \n "    ];" \n "  }," \n "  []," \n "  100," \n "  true," \n "  true," \n "  """"," \n "  ""isServer""," \n "  2" \n "];" \n "" \n "" \n "this addAction [" \n "  ""Start Mission (no zeus, live)""," \n "  {" \n "    if (!isServer) exitWith { };" \n "" \n "" \n "    ""// 1: Fade to Black"";" \n "    missionNamespace setVariable [" \n "      ""ace_hearing_disableVolumeUpdate""," \n "      true," \n "      true" \n "    ];" \n "    [0, ""BLACK"", 0.2] remoteExec [""BIS_fnc_fadeEffect""];" \n "    [0.2, 0] remoteExec [""fadeSound""];" \n "" \n "" \n "    ""// 2: Teleport Players"";" \n "    sleep 2;" \n "    _allPlayers = call BIS_fnc_listPlayers;" \n "    {" \n "      if (isNull (getAssignedCuratorLogic _x)) then {" \n "        if (vehicle _x != _x) then {" \n "          moveOut _x;" \n "        };" \n "        _x moveInCargo intro_pelican;" \n "      };" \n "    } forEach _allPlayers;" \n "" \n "" \n "    ""// 3: Play recording"";" \n "[[intro_pelican],""intro_in.sqf""] remoteExec [""BIS_fnc_execVM"",0,false];" \n "" \n "" \n "    ""// 4: Fade back in"";" \n "    sleep 2;" \n "    setTimeMultiplier 1;" \n "    [1, ""BLACK"", 3] remoteExec [""BIS_fnc_fadeEffect""];" \n "    [3, 1] remoteExec [""fadeSound""];" \n "    sleep 3;" \n "    missionNamespace setVariable [" \n "      ""ace_hearing_disableVolumeUpdate""," \n "      false," \n "      true" \n "    ];" \n "  }," \n "  []," \n "  100," \n "  true," \n "  true," \n "  """"," \n "  ""isServer""," \n "  2" \n "];" \n "";
