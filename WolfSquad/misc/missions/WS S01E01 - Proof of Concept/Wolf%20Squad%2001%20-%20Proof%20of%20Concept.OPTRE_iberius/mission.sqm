								onActivation="""Running """"Elevator Variable Setup"""""" call IG_fnc_DebugMsg;" \n "" \n "elevatorIsMoving = false;" \n "publicVariable ""elevatorIsMoving"";" \n "" \n "elevatorCurrentFloor = 152;" \n "publicVariable ""elevatorCurrentFloor"";" \n "" \n "elevatorCurrentVirtualFloor = 152;" \n "publicVariable ""elevatorCurrentVirtualFloor"";" \n "" \n "elevatorShowFloorCounter = false;" \n "publicVariable ""elevatorShowFloorCounter"";" \n "" \n "elevatorShaking = false;" \n "publicVariable ""elevatorShaking"";" \n "" \n "floors = [" \n "  [" \n "    154," \n "    ""Rooftop""," \n "    elevatorAreaRoof," \n "    elevatorCubeRoof," \n "    elevatorDoorRoof," \n "    callElevatorRoof," \n "    elevatorPanelRoof," \n "    ""true""" \n "  ]," \n "  [" \n "    152," \n "    ""Floor 152""," \n "    elevatorArea152," \n "    elevatorCube152," \n "    elevatorDoor152," \n "    callElevator152," \n "    elevatorPanel152," \n "    ""true""" \n "  ]," \n "  [" \n "    106," \n "    ""Floor 106""," \n "    elevatorArea106," \n "    elevatorCube106," \n "    elevatorDoor106," \n "    callElevator106," \n "    elevatorPanel106," \n "    ""floor106Unlocked""" \n "  ]," \n "  [" \n "    43," \n "    ""Floor 43""," \n "    elevatorArea43," \n "    elevatorCube43," \n "    elevatorDoor43," \n "    callElevator43," \n "    elevatorPanel43," \n "    ""floor43Unlocked""" \n "  ]," \n "  [" \n "    -6," \n "    ""Floor B6""," \n "    elevatorAreaB6," \n "    elevatorCubeB6," \n "    elevatorDoorB6," \n "    callElevatorB6," \n "    elevatorPanelB6," \n "    ""floorB6Unlocked""" \n "  ]" \n "];" \n "publicVariable ""floors"";" \n "" \n "elevatorPanels = [];" \n "{" \n "  elevatorPanels append [" \n "    [_x select 6, _x select 2]" \n "  ];" \n "} forEach floors;" \n "format [""ElevatorPanels: %1"", elevatorPanels] call IG_fnc_DebugMsg;" \n "publicVariable ""elevatorPanels"";" \n "" \n "" \n "" \n "elevatorSetupDone = true;" \n "publicVariable ""elevatorSetupDone"";";
								sizeA=0;
