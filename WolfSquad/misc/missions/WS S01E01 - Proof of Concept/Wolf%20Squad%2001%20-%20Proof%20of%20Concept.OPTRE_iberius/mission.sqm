							atlOffset=1.8365722;
						};
						class Item1
						{
							dataType="Trigger";
							position[]={49,4.3500004,4050.5};
							class Attributes
							{
								text="Elevator Shake Logic";
								condition="ElevatorShaking";
								onActivation="_currFloor = elevatorCurrentFloor call IG_fnc_GetFloor;" \n "_currArea = _currFloor select 2;" \n "" \n "_soundPath = ""a3\Sounds_F_Decade\Assets\Props\LinkTerminal_01_node_main_F\Link_Terminal03_Loop.wss"";" \n "" \n "if (player inArea _currArea) then {" \n "  addCamShake [0.5, 9999, 10];" \n "" \n "  ""// Play sound on a loop"";" \n "  _soundPath spawn {" \n "    params [""_soundPath""];" \n "    while { ElevatorShaking } do" \n "    {" \n "      _sound = playSoundUI [" \n "        _soundPath," \n "        0.008," \n "        1" \n "      ];" \n "      player setVariable [""elevatorSound"", _sound];" \n "      waitUntil { soundParams _sound isEqualTo [] };" \n "    };" \n "  };" \n "}";
								onDeactivation="resetCamShake;" \n "" \n "_sound = player getVariable ""elevatorSound"";" \n "stopSound _sound;";
								sizeA=0;
								sizeB=0;
								repeatable=1;
