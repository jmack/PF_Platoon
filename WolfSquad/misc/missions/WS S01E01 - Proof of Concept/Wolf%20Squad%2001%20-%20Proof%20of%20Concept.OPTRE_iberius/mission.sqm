						class Item0
						{
							dataType="Trigger";
							position[]={49,4.3500004,4050.1001};
							class Attributes
							{
								text="Elevator Core Logic";
								condition="elevatorSetupDone" \n "&& IG_fnc_DisplayFloorNumber_Ready" \n "&& IG_fnc_ElevatorMove_Ready" \n "&& IG_fnc_GetFloor_Ready";
								onActivation="""Running """"Elevator Core Logic"""""" call IG_fnc_DebugMsg;" \n "" \n "{" \n "  _floor           = _x;" \n "  _floorNumber     = _x select 0;" \n "  _floorName       = _x select 1;" \n "  _floorArea       = _x select 2;" \n "  _floorCube       = _x select 3;" \n "  _floorDoor       = _x select 4;" \n "  _floorCallPanel  = _x select 5;" \n "  _floorMainPanel  = _x select 6;" \n "  _enableCondition = _x select 7;" \n "" \n "" \n "  ""// Setup Call Panel"";" \n "  _floorCallPanel addAction" \n "  [" \n "    ""Call Elevator""," \n "    {" \n "      params [""_target"", ""_caller"", ""_actionId"", ""_arguments""];" \n "      _callPanel = _arguments select 0;" \n "      _destFloorNumber = _arguments select 1;" \n "" \n "      _currFloor = elevatorCurrentFloor call IG_fnc_GetFloor;" \n "      _destFloor = _destFloorNumber call IG_fnc_GetFloor;" \n "" \n "      playSound3D [" \n "        'z\ace\addons\javelin\data\sounds\javelin_locking.ogg'," \n "        _callPanel" \n "      ];" \n "" \n "      if (elevatorCurrentFloor != _destFloorNumber) then" \n "      {" \n "        [" \n "          _currFloor," \n "          _destFloor" \n "        ] call IG_fnc_ElevatorMove;" \n "      } else {" \n "        _door = _currFloor select 4;" \n "        sleep 1;" \n "        playSound3D [" \n "          '\z\phen\addons\common\sounds\success.ogg'," \n "          _door" \n "        ];" \n "        sleep 2;" \n "        _door animate [""Door_1_a_rot"", 1];" \n "        _door animate [""Door_1_b_rot"", 1];" \n "        sleep 13;" \n "        _door animate [""Door_1_a_rot"", 0];" \n "        _door animate [""Door_1_b_rot"", 0];" \n "      };" \n "    }," \n "    [_floorCallPanel, _floorNumber]," \n "    1.5," \n "    true," \n "    false," \n "    """"," \n "    ""!elevatorIsMoving""," \n "    5" \n "  ];" \n "" \n "" \n "  ""// Ability to open doors from the inside"";" \n "  _floorMainPanel addAction" \n "  [" \n "    ""Open Doors""," \n "    {" \n "      params [""_target"", ""_caller"", ""_actionId"", ""_arguments""];" \n "" \n "      _door = _arguments select 0;" \n "" \n "      _door animate [""Door_1_a_rot"", 1];" \n "      _door animate [""Door_1_b_rot"", 1];" \n "      sleep 13;" \n "      _door animate [""Door_1_a_rot"", 0];" \n "      _door animate [""Door_1_b_rot"", 0];" \n "    }," \n "    [_floorDoor]," \n "    99999," \n "    true," \n "    false," \n "    """"," \n "    format [" \n "      ""!elevatorIsMoving && elevatorCurrentFloor == %1""," \n "      _floorNumber" \n "    ]," \n "    5" \n "  ];" \n "" \n "" \n "  ""// Set up movement to other floors"";" \n "  {" \n "    if (_floorNumber == _x select 0) then { continue; };" \n "" \n "    _floorMainPanel addAction" \n "    [" \n "      _x select 1," \n "      {" \n "        params [""_target"", ""_caller"", ""_actionId"", ""_arguments""];" \n "" \n "        ""move floors action called"" call IG_fnc_DebugMsg;" \n "        format [""destFloor: %1"", (_arguments select 1) select 0]" \n "          call IG_fnc_DebugMsg;" \n "" \n "        playSound3D [" \n "          'z\ace\addons\javelin\data\sounds\javelin_locking.ogg'," \n "          _arguments select 2" \n "        ];" \n " " \n "        [" \n "          _arguments select 0," \n "          _arguments select 1" \n "        ] call IG_fnc_ElevatorMove;" \n "      }," \n "      [_floor, _x, _floorMainPanel]," \n "      90000 + (_x select 0)," \n "      true," \n "      false," \n "      """"," \n "      format [""!elevatorIsMoving && %1"", _x select 7]," \n "      5" \n "    ];" \n "  } forEach floors;" \n "} forEach floors;";
								sizeA=0;
								sizeB=0;
							};
