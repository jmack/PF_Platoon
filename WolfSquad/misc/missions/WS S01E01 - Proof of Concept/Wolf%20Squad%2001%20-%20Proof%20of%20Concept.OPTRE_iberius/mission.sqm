								onActivation="""elevatorShowFloorCounter marked true"" call IG_fnc_DebugMsg;" \n "" \n """adding Draw3D handler"" call IG_fnc_DebugMsg;" \n "  " \n "_eventHandler = addMissionEventHandler [""Draw3D"", {" \n "  {" \n "    _x call IG_fnc_DisplayFloorNumber;" \n "  } forEach ElevatorPanels;" \n "}];" \n "" \n "format [""OnActivation: %1"", _eventHandler] call IG_fnc_DebugMsg;" \n "player setVariable [""elevatorEventHandler"", _eventHandler];";
								onDeactivation="_eventHandler = player getVariable ""elevatorEventHandler"";" \n "format [""Remove Draw3D handler %1"", _eventHandler] call IG_fnc_DebugMsg;" \n "removeMissionEventHandler [""Draw3D"", _eventHandler];";
