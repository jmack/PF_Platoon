												class Item4
												{
													dataType="Trigger";
													position[]={4000.6699,21.063002,71.363998};
													class Attributes
													{
														text="Airlock Core Logic";
														condition="airlockVariableSetupDone";
														onActivation="""Running """"Airlock Core Logic"""""" call IG_fnc_DebugMsg;" \n "" \n "{" \n "  format [""setting up panel for %1"", _x select 0] call IG_fnc_DebugMsg;" \n "" \n "  (_x select 0) addAction " \n "  [ " \n "   ""Cycle Cleanroom"", " \n "   { " \n "     params [""_target"", ""_caller"", ""_actionId"", ""_arguments""];" \n "" \n "     _panel                   = _arguments select 0;" \n "     _first_door              = _arguments select 1;" \n "     _second_door             = _arguments select 2;" \n "     _first_door_jammed_name  = _arguments select 3;" \n "     _second_door_jammed_name = _arguments select 4;" \n "" \n "      playSound3D [" \n "        'z\ace\addons\javelin\data\sounds\javelin_locking.ogg'," \n "        _panel" \n "      ];" \n "" \n "     _light_red_x   = getPosASL clean_light_red select 0;" \n "     _light_green_x = getPosASL clean_light_green select 0;" \n "     _light_y_off   = getPosASL clean_light_red select 1;" \n "     _light_y_on    = _light_y_off - 1;" \n "     _light_z       = getPosASL clean_light_red select 2;" \n "" \n "     _light_door_x_inner = getPosASL clean_light_red_inner select 0;" \n "     _light_door_x_outer = getPosASL clean_light_red_outer select 0;" \n "     _light_door_y_off = getPosASL clean_light_red_inner select 1;" \n "     _light_door_y_on = _light_door_y_off + 1;" \n "     _light_door_z = getPosASL clean_light_red_inner select 2;" \n "" \n "     cleanRoomCycling = true;" \n "     publicVariable ""cleanRoomCycling"";" \n "" \n "     ""// Open first door"";" \n "     _first_door animate [""Door_1_a_rot"", 1];" \n "     _first_door animate [""Door_1_b_rot"", 1];" \n "     sleep 2;" \n "" \n "     ""// Turn on red light"";" \n "     clean_light_red setPosASL [" \n "       _light_red_x," \n "       _light_y_on," \n "       _light_z" \n "     ];" \n "     clean_light_red_inner setPosASL [" \n "       _light_door_x_inner," \n "       _light_door_y_on," \n "       _light_door_z" \n "     ];" \n "     clean_light_red_outer setPosASL [" \n "       _light_door_x_outer," \n "       _light_door_y_on," \n "       _light_door_z" \n "     ];" \n "     sleep 8;" \n "" \n "     ""// Close first door (if not jammed)"";" \n "     if (!(missionNamespace getVariable _first_door_jammed_name)) then {" \n "       _first_door animate [""Door_1_a_rot"", 0];" \n "       _first_door animate [""Door_1_b_rot"", 0];" \n "     };" \n "     sleep 3;" \n "" \n "     ""// Show decon effects"";" \n "     cleanRoomDeconOn = true;" \n "     publicVariable ""cleanRoomDeconOn"";" \n "     sleep 15;" \n "" \n "     cleanRoomDeconOn = false;" \n "     publicVariable ""cleanRoomDeconOn"";" \n "     sleep 1;" \n "" \n "     ""// Show green light"";" \n "     clean_light_red setPosASL [" \n "       _light_red_x," \n "       _light_y_off," \n "       _light_z" \n "     ];" \n "     clean_light_red_inner setPosASL [" \n "       _light_door_x_inner," \n "       _light_door_y_off," \n "       _light_door_z" \n "     ];" \n "     clean_light_red_outer setPosASL [" \n "       _light_door_x_outer," \n "       _light_door_y_off," \n "       _light_door_z" \n "     ];" \n "     clean_light_green setPosASL [" \n "       _light_green_x," \n "       _light_y_on," \n "       _light_z" \n "     ];" \n "     clean_light_green_inner setPosASL [" \n "       _light_door_x_inner," \n "       _light_door_y_on," \n "       _light_door_z" \n "     ];" \n "     clean_light_green_outer setPosASL [" \n "       _light_door_x_outer," \n "       _light_door_y_on," \n "       _light_door_z" \n "     ];" \n "     sleep 3;" \n "" \n "     ""// Open second door"";" \n "     _second_door animate [""Door_1_a_rot"", 1];" \n "     _second_door animate [""Door_1_b_rot"", 1];" \n "     sleep 10;" \n "" \n "     ""// Close second door (if not jammed)"";" \n "     if (!(missionNamespace getVariable _second_door_jammed_name)) then {" \n "       _second_door animate [""Door_1_a_rot"", 0];" \n "       _second_door animate [""Door_1_b_rot"", 0];" \n "     };" \n "     sleep 3;" \n "" \n "     ""// Turn off lights"";" \n "     clean_light_red setPosASL [" \n "       _light_red_x," \n "       _light_y_off," \n "       _light_z" \n "     ];" \n "     clean_light_red_inner setPosASL [" \n "       _light_door_x_inner," \n "       _light_door_y_off," \n "       _light_door_z" \n "     ];" \n "     clean_light_red_outer setPosASL [" \n "       _light_door_x_outer," \n "       _light_door_y_off," \n "       _light_door_z" \n "     ];" \n "     clean_light_green setPosASL [" \n "       _light_green_x," \n "       _light_y_off," \n "       _light_z" \n "     ];" \n "     clean_light_green_inner setPosASL [" \n "       _light_door_x_inner," \n "       _light_door_y_off," \n "       _light_door_z" \n "     ];" \n "     clean_light_green_outer setPosASL [" \n "       _light_door_x_outer," \n "       _light_door_y_off," \n "       _light_door_z" \n "     ];" \n "     cleanRoomCycling = false;" \n "     publicVariable ""cleanRoomCycling"";" \n "   }," \n "   _x," \n "   1.5," \n "   true," \n "   false," \n "   """"," \n "   ""cleanRoomCycling == false""," \n "   8" \n "  ];" \n "} forEach panels;";
														sizeA=0;
														sizeB=0;
													};
													id=8984;
													type="EmptyDetector";
													atlOffset=0.72978973;
												};
