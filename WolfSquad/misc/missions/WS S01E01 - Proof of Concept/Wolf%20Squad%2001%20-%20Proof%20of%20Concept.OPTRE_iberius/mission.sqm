																					class Attributes
																					{
																						text="Overheat Handler";
																						condition="true";
																						onActivation="fn_DestroyServer = {" \n "  params [""_server""];" \n "" \n "  _serverSparkPair = [];" \n "  {" \n "    if (_x#0 == _server) then {" \n "      _serverSparkPair = _x;" \n "    };" \n "  } forEach AllServers;" \n "" \n "  _serverSparkPair#1 hideObjectGlobal false;" \n "  _serverSparkPair#1 enableSimulationGlobal true;" \n "" \n "  ""// mark server destroyed"";" \n "  _server setVariable [""destroyed"", true, true];" \n "" \n "  ""// update # of destroyed servers"";" \n "  _deadServers = missionNamespace getVariable [""deadServers"", 0];" \n "  missionNamespace setVariable [""deadServers"", _deadServers + 1];" \n "};" \n "publicVariable ""fn_DestroyServer"";" \n "" \n "" \n "fn_DestroyAllServers = {" \n "  {" \n "    if (!(_x#0 getVariable [""destroyed"", false])) then {" \n "      _x#0 call fn_DestroyServer;" \n "    };" \n "  } forEach AllServers;" \n "" \n "  {" \n "    _x hideObjectGlobal false;" \n "    _x enableSimulationGlobal true;" \n "  } forEach [fire_1, fire_2, fire_3];" \n "" \n "  missionNamespace setVariable [""aiDestroyed"", true, true];" \n "};" \n "publicVariable ""fn_DestroyAllServers"";" \n "" \n "" \n "AllServers = [" \n "  [server_1,  spark_1]," \n "  [server_2,  spark_2]," \n "  [server_3,  spark_3]," \n "  [server_4,  spark_4]," \n "  [server_5,  spark_5]," \n "  [server_6,  spark_6]," \n "  [server_7,  spark_7]," \n "  [server_8,  spark_8]," \n "  [server_9,  spark_9]," \n "  [server_10, spark_10]" \n "];" \n "publicVariable ""AllServers"";";
																						sizeA=0;
																						sizeB=0;
																					};
