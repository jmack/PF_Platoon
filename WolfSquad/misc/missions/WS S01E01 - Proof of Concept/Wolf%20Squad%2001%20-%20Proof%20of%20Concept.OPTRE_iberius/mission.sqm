						class Item4
						{
							dataType="Trigger";
							position[]={49,4.3500004,4050.3999};
							class Attributes
							{
								text="IG_fnc_DisplayFloorNumber";
								condition="elevatorSetupDone";
								onActivation="IG_fnc_DisplayFloorNumber = {" \n "  params [""_panel"", ""_area""];" \n "" \n "  if (player inArea _area) then {" \n "    _panelPos = getPosASL _panel;" \n "    _panelPos = [" \n "      _panelPos select 0," \n "      _panelPos select 1," \n "      (_panelPos select 2) + 0.3" \n "    ];" \n "    _k = 5 / ((ASLToAGL eyePos player) distance (ASLToAGL _panelPos));" \n "" \n "    _floor = format [""%1"", elevatorCurrentVirtualFloor];" \n "" \n "    if (elevatorCurrentVirtualFloor == 0) then {" \n "      _floor = ""G"";" \n "    };" \n "" \n "    if (elevatorCurrentVirtualFloor < 0) then {" \n "      _floor = format [""B%1"", elevatorCurrentVirtualFloor * -1];" \n "    };" \n "" \n "    drawIcon3D" \n "    [" \n "      """"," \n "      [[1,1,1,1], [0.4,0.8,1,1]]," \n "      ASLtoAGL _panelPos," \n "      0," \n "      0," \n "      0," \n "      _floor," \n "      0," \n "      0.05 * _k," \n "      ""EtelkaMonospacePro""," \n "      ""center""" \n "    ];" \n "  }" \n "};" \n "publicVariable ""IG_fnc_DisplayFloorNumber"";" \n "" \n "IG_fnc_DisplayFloorNumber_Ready = true;" \n "publicVariable ""IG_fnc_DisplayFloorNumber_Ready"";" \n "" \n """IG_fnc_DisplayFloorNumber initialized"" call IG_fnc_DebugMsg;";
