																					class Attributes
																					{
																						init="""cable not plugged in"";" \n "[" \n "  this," \n "  ""search""," \n "  ""Examine""," \n "  ""!(missionNamespace getVariable [""""networkCableAttached"""", false])""," \n "  { " \n "    ""A network control panel. It currently shows 'Local Network Status: No Connection'."" call IG_fnc_DisplayEnvMsg;" \n "  }," \n "  1," \n "  false" \n "] call WS_fnc_holdAction;" \n "" \n "" \n "" \n """cable plugged in but terminal not interacted"";" \n "[" \n "  this," \n "  ""search""," \n "  ""Examine""," \n "  ""(missionNamespace getVariable [""""networkCableAttached"""", false])" \n "   && !(missionNamespace getVariable [""""aiReleased"""", false])""," \n "  { " \n "    ""A network control panel. It currently shows 'Local Network Status: Disabled'."" call IG_fnc_DisplayEnvMsg;" \n "  }," \n "  1," \n "  false" \n "] call WS_fnc_holdAction;" \n "" \n "[" \n "  this," \n "  ""interact""," \n "  ""Enable local network""," \n "  ""(missionNamespace getVariable [""""networkCableAttached"""", false])" \n "   && !(missionNamespace getVariable [""""aiReleased"""", false])""," \n "  {" \n "    if ((missionNamespace getVariable [""aiDestroyed"", false]) ||" \n "        (missionNamespace getVariable [""aiReleased"", false]) ||" \n "        (missionNamespace getVariable [""aiSecured"", false])) then {" \n "      ""Network connection enabled."" call IG_fnc_DisplayEnvMsg;" \n "    } else {" \n "      ""Network connection enabled. Immediately the traffic spikes as the AI transfers itself through the network and into the wider waypoint."" call IG_fnc_DisplayEnvMsg;" \n "      missionNamespace setVariable [""aiReleased"", true, true];" \n "      deleteVehicle vrVisible;" \n "    };    " \n "  }," \n "  15," \n "  false" \n "] call WS_fnc_holdAction;" \n "" \n "" \n "" \n """cable plugged in and terminal interacted"";" \n "[" \n "  this," \n "  ""search""," \n "  ""Examine""," \n "  ""(missionNamespace getVariable [""""networkCableAttached"""", false])" \n "   && (missionNamespace getVariable [""""aiReleased"""", false])""," \n "  { " \n "    ""A network control panel. It currently shows 'Local Network Status: Connected'."" call IG_fnc_DisplayEnvMsg;" \n "  }," \n "  1," \n "  false" \n "] call WS_fnc_holdAction;";
																						disableSimulation=1;
																					};
