						class Item6
						{
							dataType="Trigger";
							position[]={49,4.3500004,4050.3};
							class Attributes
							{
								text="IG_fnc_ElevatorMove";
								condition="elevatorSetupDone";
								onActivation="IG_fnc_ElevatorMove = {" \n "  params [""_currFloor"", ""_destFloor""];" \n "" \n "  ""IG_fnc_ElevatorMove called"" call IG_fnc_DebugMsg;" \n "  format [""currFloor: %1"", _currFloor select 0] call IG_fnc_DebugMsg;" \n "  format [""destFloor: %1"", _destFloor select 0] call IG_fnc_DebugMsg;" \n "" \n "  _currNumber     = _currFloor select 0;" \n "  _currName       = _currFloor select 1;" \n "  _currArea       = _currFloor select 2;" \n "  _currCube       = _currFloor select 3;" \n "  _currDoor       = _currFloor select 4;" \n "" \n "  _destNumber     = _destFloor select 0;" \n "  _destName       = _destFloor select 1;" \n "  _destArea       = _destFloor select 2;" \n "  _destCube       = _destFloor select 3;" \n "  _destDoor       = _destFloor select 4;" \n "" \n "  ""// doors close"";" \n "  _currDoor animate [""Door_1_a_rot"", 0];" \n "  _currDoor animate [""Door_1_b_rot"", 0];" \n "  elevatorIsMoving = true;" \n "  publicVariable ""elevatorIsMoving"";" \n "" \n "  ""Doors Close sleep"" call IG_fnc_DebugMsg;" \n "  sleep 2;" \n "" \n "  _playersInElevator = allPlayers inAreaArray _currArea;" \n "  _floorsToTraverse = abs (_destNumber - _currNumber);" \n "" \n "  ""Delay sleep"" call IG_fnc_DebugMsg;" \n "  elevatorShowFloorCounter = true;" \n "  publicVariable ""elevatorShowFloorCounter"";" \n "  sleep 1;" \n "" \n "  ""// Shake slightly"";" \n "  elevatorShaking = true;" \n "  publicVariable ""elevatorShaking"";" \n "  " \n "  ""Elevator Ramp Up sleep"" call IG_fnc_DebugMsg;" \n "  sleep 2;" \n "" \n "  ""// it takes .5s per floor traveled"";" \n "  _direction = 1;" \n "  if (_currNumber > _destNumber) then { _direction = -1; };" \n "" \n "  while { elevatorCurrentVirtualFloor != _destNumber } do {" \n "    elevatorCurrentVirtualFloor =" \n "      elevatorCurrentVirtualFloor + _direction;" \n "    publicVariable ""elevatorCurrentVirtualFloor"";" \n "    format [""%1"", elevatorCurrentVirtualFloor] call IG_fnc_DebugMsg;" \n "    sleep 0.5;" \n "  };" \n "" \n "  ""// move player"";" \n "  {" \n "    _currCubePos = getPosASL _currCube;" \n "    _currCubeDir = getDir _currCube;" \n "    _currPlayerPos = getPosASL _x;" \n "    _relativeTranslation = [" \n "      (_currPlayerPos select 0) - (_currCubePos select 0)," \n "      (_currPlayerPos select 1) - (_currCubePos select 1)," \n "      (_currPlayerPos select 2) - (_currCubePos select 2)      " \n "    ];" \n "" \n "    format [""currCubePos: %1"", _currCubePos] call IG_fnc_DebugMsg;" \n "    format [""currCubeDir: %1"", _currCubeDir] call IG_fnc_DebugMsg;" \n "    format [""currPlayerPos: %1"", _currPlayerPos] call IG_fnc_DebugMsg;" \n "    format [""relativeTranslation: %1"", _relativeTranslation]" \n "      call IG_fnc_DebugMsg;" \n "" \n "    _destCubePos = getPosASL _destCube;" \n "    _destCubeDir = getDir _destCube;" \n "    _dirDiff = _destCubeDir - _currCubeDir;" \n "" \n "    _newPlayerRawVector = [" \n "      _relativeTranslation select 0," \n "      _relativeTranslation select 1" \n "    ];" \n "" \n "    format [""destCubePos: %1"", _destCubePos] call IG_fnc_DebugMsg;" \n "    format [""destCubeDir: %1"", _destCubeDir] call IG_fnc_DebugMsg;" \n "    format [""dirDiff: %1"", _dirDiff] call IG_fnc_DebugMsg;" \n "" \n "    _newPlayerAdjVector = [" \n "      _newPlayerRawVector," \n "      -(_dirDiff)" \n "    ] call BIS_fnc_rotateVector2D;" \n "" \n "    format [""newPlayerRawVector: %1"", _newPlayerRawVector]" \n "      call IG_fnc_DebugMsg;" \n "    format [""newPlayerAdjVector: %1"", _newPlayerAdjVector]" \n "      call IG_fnc_DebugMsg;" \n "" \n "    _newPlayerPos = [" \n "      (_destCubePos select 0) + (_newPlayerAdjVector select 0)," \n "      (_destCubePos select 1) + (_newPlayerAdjVector select 1)," \n "      (_destCubePos select 2) + (_relativeTranslation select 2)" \n "    ];" \n "" \n "    format [""playerDir: %1"", getDir _x] call IG_fnc_DebugMsg;" \n "    _newPlayerDir = (((getDir _x) + _dirDiff) + 360) % 360;" \n "" \n "    format [""newPlayerPos: %1"", _newPlayerPos] call IG_fnc_DebugMsg;" \n "    format [""newPlayerDir: %1"", _newPlayerDir] call IG_fnc_DebugMsg;" \n "" \n "    _x setDir _newPlayerDir;" \n "    _x setPosASL _newPlayerPos;" \n "  } forEach _playersInElevator;" \n "" \n "  elevatorCurrentFloor = _destNumber;" \n "  publicVariable ""elevatorCurrentFloor"";" \n "  ""Elevator Ramp Down sleep"" call IG_fnc_DebugMsg;" \n "  sleep 2;" \n "" \n "  elevatorShaking = false;" \n "  publicVariable ""elevatorShaking"";" \n "  " \n "  sleep 0.5;" \n "  playSound3D ['\z\phen\addons\common\sounds\success.ogg', _destDoor];" \n "  ""Delay sleep"" call IG_fnc_DebugMsg;" \n "  sleep 1;" \n "" \n "  elevatorShowFloorCounter = false;" \n "  publicVariable ""elevatorShowFloorCounter"";" \n "" \n "  ""// open doors on destination floor"";" \n "  _destDoor animate [""Door_1_a_rot"", 1];" \n "  _destDoor animate [""Door_1_b_rot"", 1];" \n "" \n "  ""Doors Open sleep"" call IG_fnc_DebugMsg;" \n "  sleep 2;" \n "" \n "  elevatorIsMoving = false;" \n "  publicVariable ""elevatorIsMoving"";" \n "" \n "  ""Delay sleep"" call IG_fnc_DebugMsg;" \n "  sleep 10;" \n "" \n "  _destDoor animate [""Door_1_a_rot"", 0];" \n "  _destDoor animate [""Door_1_b_rot"", 0];" \n "" \n "  ""Doors Close sleep"" call IG_fnc_DebugMsg;" \n "  sleep 2;" \n "};" \n "publicVariable ""IG_fnc_ElevatorMove"";" \n "" \n "IG_fnc_ElevatorMove_Ready = true;" \n "publicVariable ""IG_fnc_ElevatorMove_Ready"";" \n "" \n """IG_fnc_ElevatorMove initialized"" call IG_fnc_DebugMsg;";
								sizeA=0;
								sizeB=0;
							};
							id=9091;
							type="EmptyDetector";
							atlOffset=1.8398914;
						};
					};
