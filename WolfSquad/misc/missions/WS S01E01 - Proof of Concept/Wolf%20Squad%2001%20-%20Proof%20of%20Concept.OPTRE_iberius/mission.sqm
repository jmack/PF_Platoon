																class Item1
																{
																	dataType="Layer";
																	name="Script Objects";
																	state=1;
																	class Entities
																	{
																		items=6;
																		class Item0
																		{
																			dataType="Object";
																			class PositionInfo
																			{
																				position[]={133.468,29.729008,102.795};
																				angles[]={0.44729298,4.712389,0};
																			};
																			side="Empty";
																			flags=5;
																			class Attributes
																			{
																				init="""If not unlocked and no keycard"";" \n "[ " \n "  this, " \n "  ""search""," \n "  ""Examine"", " \n "  ""!(_this getVariable [""""hasAIKeycard"""", false])" \n "  && !(missionNamespace getVariable [""""aiRoomConsoleUnlocked"""", false])""," \n "  { " \n "    ""It seems to want a security keycard to be unlocked""" \n "      call IG_fnc_DisplayEnvMsg;" \n "  }, " \n "  2, " \n "  false" \n "] call WS_fnc_holdAction;" \n "" \n "" \n """If not unlocked and yes keycard"";" \n "[ " \n "  this, " \n "  ""interact""," \n "  ""Unlock terminal"", " \n "  ""_this getVariable [""""hasAIKeycard"""", false]" \n "  && !(missionNamespace getVariable [""""aiRoomConsoleUnlocked"""", false])""," \n "  { " \n "    params [""_target""];" \n "    missionNamespace setVariable [""aiRoomConsoleUnlocked"", true, true];" \n "    _target setObjectTextureGlobal [" \n "      0," \n "      ""images\devices\aiRoom_mainUnlocked.paa""" \n "    ];" \n "  }, " \n "  2, " \n "  false" \n "] call WS_fnc_holdAction;" \n "" \n "" \n """hacker - unlock terminal"";" \n "[ " \n "  this, " \n "  ""hacking""," \n "  ""Bypass terminal security"", " \n "  ""!(missionNamespace getVariable [""""aiRoomConsoleUnlocked"""", false])""," \n "  { " \n "    params [""_target""];" \n "    missionNamespace setVariable [""aiRoomConsoleUnlocked"", true, true];" \n "    _target setObjectTextureGlobal [" \n "      0," \n "      ""images\devices\aiRoom_mainUnlocked.paa""" \n "    ];" \n "  }, " \n "  10, " \n "  false" \n "] call WS_fnc_holdAction;" \n "" \n "" \n "" \n """hacker [destroy] - purge databanks"";" \n "[ " \n "  this, " \n "  ""hacking""," \n "  ""Purge AI from databanks"", " \n "  ""missionNamespace getVariable [""""aiRoomConsoleUnlocked"""", false]" \n "   && !(missionNamespace getVariable [""""aiInSecureStorage"""", false])" \n "   && !(missionNamespace getVariable [""""aiDestroyed"""", false])" \n "   && !(missionNamespace getVariable [""""aiReleased"""", false])" \n "   && !(missionNamespace getVariable [""""aiSecured"""", false])""," \n "  { " \n "    missionNamespace setVariable [""aiDestroyed"", true, true];" \n "    ""Purge begun. The AI will be deleted momentarily."" call IG_fnc_DisplayEnvMsg;" \n "    deleteVehicle vrVisible;" \n "  }, " \n "  15, " \n "  false" \n "] call WS_fnc_holdAction;" \n "" \n "" \n """hacker [release] - break through firewall"";" \n "[ " \n "  this, " \n "  ""hacking""," \n "  ""Crack firewall and connect AI to main network"", " \n "  ""missionNamespace getVariable [""""aiRoomConsoleUnlocked"""", false]" \n "   && !(missionNamespace getVariable [""""aiInSecureStorage"""", false])" \n "   && !(missionNamespace getVariable [""""aiDestroyed"""", false])" \n "   && !(missionNamespace getVariable [""""aiReleased"""", false])" \n "   && !(missionNamespace getVariable [""""aiSecured"""", false])""," \n "  { " \n "    deleteVehicle vrVisible;" \n "    missionNamespace setVariable [""aiDestroyed"", true, true];" \n "    ""Firewall breached. Logs show the AI immediately escaped into the waypoint."" call IG_fnc_DisplayEnvMsg;" \n "  }, " \n "  15, " \n "  false" \n "] call WS_fnc_holdAction;" \n "" \n "" \n """any [secure] - transfer AI to data matrix"";" \n "[ " \n "  this, " \n "  ""interact""," \n "  ""Transfer AI matrix to portable storage"", " \n "  ""missionNamespace getVariable [""""aiRoomConsoleUnlocked"""", false]" \n "   && !(missionNamespace getVariable [""""aiInSecureStorage"""", false])" \n "   && !(missionNamespace getVariable [""""aiDestroyed"""", false])" \n "   && !(missionNamespace getVariable [""""aiReleased"""", false])" \n "   && !(missionNamespace getVariable [""""aiSecured"""", false])""," \n "  {" \n "    deleteVehicle vrVisible;" \n "    missionNamespace setVariable [""aiInSecureStorage"", true, true];" \n "    ""The 'AI Matrix Storage Device' device can now be safely removed from the computer."" call IG_fnc_DisplayEnvMsg;" \n "  }, " \n "  15, " \n "  false" \n "] call WS_fnc_holdAction;";
																				disableSimulation=1;
																			};
